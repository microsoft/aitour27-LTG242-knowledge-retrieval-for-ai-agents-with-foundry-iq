		lineageTag: 089cf4e8-1a2a-4e93-bc1c-d5105a103ae8
		summarizeBy: none
		sourceColumn: Quarter

	column QuarterName
		dataType: string
		lineageTag: 4f931c33-96cf-47e4-983d-425445610ee4
		sourceColumn: QuarterName

	column MonthNumber
		dataType: int64
		lineageTag: 9bc990b4-be70-4897-b7c7-1dd5f88e1e36
		summarizeBy: none
		sourceColumn: MonthNumber

	column MonthName
		dataType: string
		lineageTag: ba24b5f4-d8c3-4553-ad55-915a955d0312
		sourceColumn: MonthName
		sortByColumn: MonthNumber

	/// Month and year label (e.g. 'Jan 2025') for trend axes.
	column MonthYear
		dataType: string
		lineageTag: c31a1908-9b85-40fb-9c15-e7db8aba916f
		sourceColumn: MonthYear
		sortByColumn: MonthKey

	column MonthKey
		dataType: int64
		isHidden
		lineageTag: c213c4c9-9183-46df-8e79-8075819ce83a
