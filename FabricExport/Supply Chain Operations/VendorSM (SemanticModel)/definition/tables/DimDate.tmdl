/// Date dimension at daily grain covering the last two years. Use for trends, time intelligence and recent-change analysis.
table DimDate
	lineageTag: 7330894e-4fdc-43e0-b9b6-ba3dd2691d8d
	sourceLineageTag: [dbo].[DimDate]
	dataCategory: Time

	column DateKey
		dataType: int64
		isHidden
		lineageTag: ecd25ddf-8e59-4e2e-896f-6440eb0dbe83
		summarizeBy: none
		sourceColumn: DateKey

	/// Calendar date of the record.
	column Date
		dataType: dateTime
		isKey
		lineageTag: cf5424f0-0b06-4e73-9189-bc17c808550f
		sourceColumn: Date

	column Year
		dataType: int64
		lineageTag: b0923d23-598c-426c-8902-531e277c4aa5
		summarizeBy: none
		sourceColumn: Year

	column Quarter
