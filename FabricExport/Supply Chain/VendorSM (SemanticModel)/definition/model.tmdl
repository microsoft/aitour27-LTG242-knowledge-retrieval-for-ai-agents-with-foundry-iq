/// Contract manufacturer (CMO) vendor analytics for Allerveo. VendorPerformance is the fact table (one row per vendor) describing quality, regulatory, capacity and commercial metrics; Vendors is the vendor dimension. Use these to compare, rank and shortlist contract manufacturers.
model Model
	culture: en-US
	collation: Latin1_General_100_BIN2_UTF8
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_ProTooling = ["SLL"]

ref table Vendors
ref table VendorPerformance
ref table DimLocation
ref table DimInspectionResult
ref table DimAuditResult
ref table DimFinancialRating

ref cultureInfo en-US

