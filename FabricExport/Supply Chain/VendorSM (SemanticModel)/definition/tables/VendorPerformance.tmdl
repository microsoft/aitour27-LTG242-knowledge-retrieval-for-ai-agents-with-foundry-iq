/// Fact table: one row per vendor with quality, regulatory, capacity and commercial KPIs. Joins to Vendors on VendorID.
table VendorPerformance
	lineageTag: c40859f0-c3a9-43ea-94a1-bb9dc93818a0
	sourceLineageTag: [dbo].[VendorPerformance]

	/// Number of vendors.
	measure 'Vendor Count' = DISTINCTCOUNT(VendorPerformance[VendorID])
		formatString: #,0
		displayFolder: KPIs
		lineageTag: 67e3ac47-898e-455a-8624-215850d0721c

	/// Average on-time-in-full delivery rate.
	measure 'Avg OTIF %' = AVERAGE(VendorPerformance[OTIF12moPct])
		formatString: 0.0%
		displayFolder: KPIs
		lineageTag: ab426728-d850-467d-bffb-c4299d06e297

	/// Average batch rejection rate.
	measure 'Avg Batch Rejection %' = AVERAGE(VendorPerformance[BatchRejectionRatePct])
		formatString: 0.0%
		displayFolder: KPIs
		lineageTag: 32984546-eee4-46bf-b14f-60232ce9271c

	/// Average right-first-time rate.
	measure 'Avg Right First Time %' = AVERAGE(VendorPerformance[RightFirstTimePct])
		formatString: 0.0%
		displayFolder: KPIs
		lineageTag: f7956aa5-306a-4486-9483-6723db32d3a9

	/// Average current plant utilization.
	measure 'Avg Utilization %' = AVERAGE(VendorPerformance[CurrentUtilizationPct])
		formatString: 0.0%
		displayFolder: KPIs
		lineageTag: a0f0f59d-536b-4279-bee0-d2fc300caedd

	/// Average lead time to first production (weeks).
	measure 'Avg Lead Time (wks)' = AVERAGE(VendorPerformance[LeadTimeToFirstProductionWks])
		formatString: 0.0
		displayFolder: KPIs
		lineageTag: bbd2bb63-2356-4402-aad0-543de1e152a4

	/// Average cost index (market = 100).
	measure 'Avg Cost Index' = AVERAGE(VendorPerformance[CostIndex])
		formatString: 0.0
		displayFolder: KPIs
		lineageTag: 944b7590-4ae9-4513-aa89-8948b4336827

	/// Average technology-transfer success rate.
	measure 'Avg Tech Transfer %' = AVERAGE(VendorPerformance[TechTransferSuccessPct])
		formatString: 0.0%
		displayFolder: KPIs
		lineageTag: 6b3c3126-c85f-4d9b-bb0d-7b227846661b

	/// Total available capacity (thousand units/month).
	measure 'Total Available Capacity (K/mo)' = SUM(VendorPerformance[AvailableCapacityKPerMonth])
		formatString: #,0
		displayFolder: KPIs
		lineageTag: 71047150-2b3f-45fc-afcd-2cdac38fce2b

	/// Total open regulatory actions across vendors.
	measure 'Total Open Reg Actions' = SUM(VendorPerformance[OpenRegulatoryActions])
		formatString: #,0
		displayFolder: KPIs
		lineageTag: 010aa215-5e8f-4283-aef6-c0c2be75c7ba

	/// Vendor key. Joins to the Vendors dimension.
	column VendorID
		dataType: string
		isHidden
		lineageTag: adab7881-7c4a-4e1a-81df-ebde4259b22c
		summarizeBy: none
		sourceColumn: VendorID

	/// On-time-in-full delivery rate, trailing 12 months.
	column OTIF12moPct
		dataType: double
		lineageTag: 8dce5e3a-74c9-4187-a479-d3a8114afe0e
		sourceColumn: OTIF12moPct

	/// Share of batches rejected for quality reasons.
	column BatchRejectionRatePct
		dataType: double
		lineageTag: 56fba49c-829d-44e7-bbbd-90bce5f40c08
		sourceColumn: BatchRejectionRatePct

	/// Share of batches produced right the first time.
	column RightFirstTimePct
		dataType: double
		lineageTag: 79461392-f283-4af7-bc9e-3f747dbecc2f
		sourceColumn: RightFirstTimePct

	/// Customer complaints per 1,000 batches.
	column CustomerComplaintsPer1k
		dataType: double
		lineageTag: f6b15f98-9ffa-41c7-bfcf-17826992f6ce
		sourceColumn: CustomerComplaintsPer1k

	column LastRegulatoryInspection
		dataType: string
		lineageTag: 9928668a-c910-48a1-9e62-3f3676b223e0
		sourceColumn: LastRegulatoryInspection

	/// Count of open regulatory actions; 0 is required to qualify.
	column OpenRegulatoryActions
		dataType: int64
		lineageTag: 4596e101-795c-4f9c-a385-856146b80a25
		sourceColumn: OpenRegulatoryActions

	/// Number of regulatory inspections in the last 3 years.
	column RegulatoryInspections3yr
		dataType: int64
		lineageTag: 24142622-4446-44d6-9f5b-05d5cfce53f9
		sourceColumn: RegulatoryInspections3yr

	column LastInternalAuditResult
		dataType: string
		lineageTag: 3a0bfc25-0095-47c1-8375-dd02e3a972d7
		sourceColumn: LastInternalAuditResult

	/// Years of oral solid dose (OSD) manufacturing experience.
	column OSDExperienceYrs
		dataType: int64
		lineageTag: 0386799f-a6dc-4d73-ba7d-e654abfb9b37
		sourceColumn: OSDExperienceYrs

	/// Available capacity in thousands of units per month.
	column AvailableCapacityKPerMonth
		dataType: int64
		lineageTag: 44f22209-d565-4771-acc1-fa827ec01b57
		sourceColumn: AvailableCapacityKPerMonth

	/// Current plant utilization; high utilization limits new capacity.
	column CurrentUtilizationPct
		dataType: double
		lineageTag: ca12f485-93b7-47b3-84ad-ba0a1f298975
		sourceColumn: CurrentUtilizationPct

	/// Lead time to first production, in weeks.
	column LeadTimeToFirstProductionWks
		dataType: int64
		lineageTag: d6d7db55-540c-4c04-8ec3-e5bb671a9950
		sourceColumn: LeadTimeToFirstProductionWks

	/// Cost index where the market average = 100; lower is cheaper.
	column CostIndex
		dataType: int64
		lineageTag: f8968290-cdf0-424e-ad74-a71e49b601b5
		sourceColumn: CostIndex

	/// Minimum order quantity in thousands of units.
	column MOQKUnits
		dataType: int64
		lineageTag: b476b56d-6a81-457f-bf0e-389a75ed097d
		sourceColumn: MOQKUnits

	/// Historical technology-transfer success rate.
	column TechTransferSuccessPct
		dataType: double
		lineageTag: 23b14950-e4fd-444b-bc2c-c8c1add7e295
		sourceColumn: TechTransferSuccessPct

	column FinancialStabilityRating
		dataType: string
		lineageTag: 62dfd523-0e95-494e-90fe-e0eef7af6718
		sourceColumn: FinancialStabilityRating

	partition VendorPerformance = entity
		mode: directLake
		source
			entityName: VendorPerformance
			expressionSource: DL_Lakehouse

