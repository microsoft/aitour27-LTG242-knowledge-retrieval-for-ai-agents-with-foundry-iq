<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>CAL-MAP-SUP-001 · Caldova global supplier footprint</title>
<style>
  @page { size:Letter landscape; margin:0; }
  * { box-sizing:border-box; }
  html, body { margin:0; color:#17242a; background:#edf1ef; font-family:"Avenir Next",Avenir,"Segoe UI",sans-serif; }
  .page { width:1056px; height:816px; position:relative; overflow:hidden; background:#f5f7f4; padding:28px 32px 22px; }
  header { display:grid; grid-template-columns:130px 1fr 250px; align-items:center; gap:20px; border-bottom:3px solid #173b42; padding-bottom:12px; }
  header img { width:112px; max-height:34px; object-fit:contain; }
  h1 { margin:0; font:700 25px/1.05 Georgia,serif; letter-spacing:0; }
  .subtitle { margin-top:4px; font-size:10px; color:#4a5a5f; }
  .doc { text-align:right; font:9px/1.45 "Courier New",monospace; }
  .summary { display:grid; grid-template-columns:1.15fr repeat(4,.55fr); gap:1px; margin:12px 0; background:#bbc6c4; border:1px solid #bbc6c4; }
  .summary div { background:white; padding:8px 10px; min-height:48px; }
  .summary b { display:block; font:700 17px Georgia,serif; color:#173b42; }
  .summary span { font-size:8px; text-transform:uppercase; }
  .maps { display:grid; grid-template-columns:1fr 1fr; gap:14px; }
  .panel { background:white; border:1px solid #aebbb8; height:570px; position:relative; overflow:hidden; }
  .panel-head { height:49px; padding:8px 12px; display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid #bdc7c5; }
  .panel.fabric .panel-head { border-top:6px solid #176b5b; }
  .panel.waypoint .panel-head { border-top:6px solid #a64b2a; }
  h2 { margin:0; font:700 15px Georgia,serif; }
  .panel-head p { margin:1px 0 0; font-size:7.5px; }
  .namespace { font:700 9px "Courier New",monospace; padding:4px 7px; border:1px solid #627672; background:#eef4f1; }
  .map { position:absolute; left:8px; right:8px; top:55px; height:270px; background:#dfe9e5; border:1px solid #b9c8c4; overflow:hidden; }
  svg { width:100%; height:100%; display:block; }
  .base-map { opacity:.82; }
  .fabric .link { stroke:#176b5b; }
  .waypoint .link { stroke:#a64b2a; }
  .link { fill:none; stroke-width:1.5; opacity:.78; }
  .site-pin .halo { fill:#fff; stroke:#fff; stroke-width:2; }
  .site-pin .dot { stroke:#fff; stroke-width:1; }
  .fabric .site-pin .dot { fill:#176b5b; }
  .waypoint .site-pin .dot { fill:#a64b2a; }
  .caldova-pin .halo { fill:#fff; stroke:#173b42; stroke-width:1; }
  .caldova-pin .dot { fill:#f5c84c; stroke:#173b42; stroke-width:1; }
  .map-label rect { fill:rgba(255,255,255,.96); stroke:#8a9995; stroke-width:1; rx:3; }
  .map-label text { fill:#17242a; font:bold 11px "Courier New",monospace; }
  .detail-frame { fill:#fff; stroke:#173b42; stroke-width:2; }
  .detail-title { fill:#173b42; font:bold 10px "Courier New",monospace; }
  .detail-map { fill:#edf2ef; stroke:#9daba7; stroke-width:1; }
  .register { position:absolute; left:10px; right:10px; bottom:10px; height:225px; display:grid; grid-template-columns:repeat(4,1fr); gap:5px; }
  .waypoint .register { grid-template-columns:repeat(4,1fr); }
  .record { padding:4px 5px; border-left:3px solid #176b5b; background:#f1f5f3; min-height:49px; }
  .waypoint .record { border-left-color:#a64b2a; }
  .record b { display:block; font:700 8px/1.2 "Courier New",monospace; }
  .record span { display:block; font-size:6.5px; line-height:1.16; margin-top:1px; }
  .record em { font-style:normal; color:#53635f; }
  .legend { position:absolute; bottom:6px; left:32px; right:32px; display:flex; justify-content:space-between; align-items:center; font-size:7.5px; }
  .legend strong { font-family:"Courier New",monospace; }
  .key { display:flex; gap:12px; }
  .key span::before { content:""; display:inline-block; width:8px; height:8px; margin-right:4px; vertical-align:-1px; border-radius:50%; border:2px solid #173b42; background:white; }
  .key .fabric-key::before { border-color:#176b5b; }
  .key .waypoint-key::before { border-color:#a64b2a; }
  .key .caldova-key::before { background:#f5c84c; }
  .notice { font:7px "Courier New",monospace; max-width:560px; text-align:right; }
</style>
</head>
<body><section class="page">
<header><img src="{{ logo_uri }}" alt="Caldova"><div><h1>Global supplier footprint</h1><div class="subtitle">Contract manufacturing, logistics, quality, and service locations</div></div><div class="doc"><b>CAL-MAP-SUP-001</b> · VERSION 1.0<br>GLOBAL PROCUREMENT · 22 JAN 2027</div></header>
<div class="summary"><div><b>Supplier coverage at a glance</b><span>Manufacturing, materials, logistics, and specialist services</span></div><div><b>7</b><span>Manufacturing partners</span></div><div><b>15</b><span>External suppliers</span></div><div><b>6</b><span>Countries represented</span></div><div><b>2</b><span>Caldova locations</span></div></div>
<div class="maps">
  <section class="panel fabric"><div class="panel-head"><div><h2>Contract manufacturing portfolio</h2><p>Business regions, sourcing status, and current performance trend</p></div><span class="namespace">VENDOR IDs · V001–V007</span></div>
    <div class="map"><svg viewBox="0 0 1000 520" aria-label="Contract manufacturing portfolio world map">
      <image class="base-map" href="{{ world_map_uri }}" x="0" y="0" width="1000" height="520" preserveAspectRatio="none"/>
      {% for site in fabric_suppliers %}<g><line class="link" x1="{{ site.x }}" y1="{{ site.y }}" x2="{{ site.x + site.dx }}" y2="{{ site.y + site.dy }}"/><g class="site-pin" transform="translate({{ site.x }},{{ site.y }})"><circle class="halo" r="8"/><circle class="dot" r="5"/></g><g class="map-label" transform="translate({{ site.x + site.dx }},{{ site.y + site.dy }})"><rect width="76" height="19"/><text x="7" y="14">{{ site.id }}</text></g></g>{% endfor %}
      {% for site in caldova_sites %}<g class="caldova-pin" transform="translate({{ site.x }},{{ site.y }})"><circle class="halo" r="9"/><circle class="dot" r="5"/></g>{% endfor %}
      <rect class="detail-frame" x="565" y="290" width="420" height="215" rx="4"/><text class="detail-title" x="578" y="307">UNITED STATES DETAIL</text>
      <svg x="575" y="314" width="400" height="180" viewBox="100 45 360 200" preserveAspectRatio="xMidYMid meet">
        <rect class="detail-map" x="100" y="45" width="360" height="200"/><image class="base-map" href="{{ world_map_uri }}" x="0" y="0" width="1000" height="520" preserveAspectRatio="none"/>
        {% for site in fabric_suppliers if site.id in ['V001','V002','V003','V004','V005','V006'] %}<g><line class="link" x1="{{ site.x }}" y1="{{ site.y }}" x2="{{ site.x + site.dx }}" y2="{{ site.y + site.dy }}"/><g class="site-pin" transform="translate({{ site.x }},{{ site.y }})"><circle class="halo" r="8"/><circle class="dot" r="5"/></g><g class="map-label" transform="translate({{ site.x + site.dx }},{{ site.y + site.dy }})"><rect width="76" height="19"/><text x="7" y="14">{{ site.id }}</text></g></g>{% endfor %}
      </svg>
    </svg></div>
    <div class="register">{% for site in fabric_suppliers if site.id != 'V007-AP' %}<div class="record"><b>{{ site.id }} · {{ site.name }}</b><span>{{ site.location }}</span><span>{{ site.role }}</span><span><em>Portfolio status:</em> {{ site.status }}</span></div>{% endfor %}</div>
  </section>
  <section class="panel waypoint"><div class="panel-head"><div><h2>Supplier locations and services</h2><p>Commercial addresses and verified operating sites</p></div><span class="namespace">SUPPLIER IDs · sup-001–sup-015</span></div>
    <div class="map"><svg viewBox="0 0 1000 520" aria-label="Supplier operations and services world map">
      <image class="base-map" href="{{ world_map_uri }}" x="0" y="0" width="1000" height="520" preserveAspectRatio="none"/>
      {% for site in waypoint_sites %}<g><line class="link" x1="{{ site.x }}" y1="{{ site.y }}" x2="{{ site.x + site.dx }}" y2="{{ site.y + site.dy }}"/><g class="site-pin" transform="translate({{ site.x }},{{ site.y }})"><circle class="halo" r="8"/><circle class="dot" r="5"/></g><g class="map-label" transform="translate({{ site.x + site.dx }},{{ site.y + site.dy }})"><rect width="88" height="19"/><text x="7" y="14">{{ site.id }}</text></g></g>{% endfor %}
      {% for site in caldova_sites %}<g class="caldova-pin" transform="translate({{ site.x }},{{ site.y }})"><circle class="halo" r="9"/><circle class="dot" r="5"/></g>{% endfor %}
      <rect class="detail-frame" x="565" y="290" width="420" height="215" rx="4"/><text class="detail-title" x="578" y="307">UNITED STATES DETAIL</text>
      <svg x="575" y="314" width="400" height="180" viewBox="100 45 360 200" preserveAspectRatio="xMidYMid meet">
        <rect class="detail-map" x="100" y="45" width="360" height="200"/><image class="base-map" href="{{ world_map_uri }}" x="0" y="0" width="1000" height="520" preserveAspectRatio="none"/>
        {% for site in waypoint_sites if site.id not in ['sup-003','sup-004','sup-006','sup-011','sup-013','sup-014'] %}<g><line class="link" x1="{{ site.x }}" y1="{{ site.y }}" x2="{{ site.x + site.dx }}" y2="{{ site.y + site.dy }}"/><g class="site-pin" transform="translate({{ site.x }},{{ site.y }})"><circle class="halo" r="8"/><circle class="dot" r="5"/></g><g class="map-label" transform="translate({{ site.x + site.dx }},{{ site.y + site.dy }})"><rect width="88" height="19"/><text x="7" y="14">{{ site.id }}</text></g></g>{% endfor %}
        {% for site in caldova_sites %}<g class="caldova-pin" transform="translate({{ site.x }},{{ site.y }})"><circle class="halo" r="9"/><circle class="dot" r="5"/></g>{% endfor %}
      </svg>
    </svg></div>
    <div class="register">{% for site in waypoint_sites %}<div class="record"><b>{{ site.id }} · {{ site.name }}</b><span>{{ site.location }}</span><span><em>Category:</em> {{ site.type }}</span></div>{% endfor %}</div>
  </section>
</div>
<footer class="legend"><div class="key"><span class="fabric-key">Manufacturing partner</span><span class="waypoint-key">External supplier</span><span class="caldova-key">Caldova location</span></div><div class="notice"><strong>LOCATION BASIS:</strong> State-level portfolio records are shown at representative state centers. Commercial records use billing cities unless identified as an operating site. Equirectangular land map generated from Natural Earth 1:110m data, public domain.</div></footer>
</section></body></html>
