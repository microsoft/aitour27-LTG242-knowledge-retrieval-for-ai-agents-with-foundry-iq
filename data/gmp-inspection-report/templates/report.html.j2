<rect class="support" x="12" y="12" width="666" height="58"/><text class="title" x="22" y="28">CAMPAIGN BP-1026 · RUN AND CAPACITY CONTEXT</text><rect class="process" x="22" y="37" width="134" height="24"/><text class="small mono" x="29" y="48">BP-1026-01 · BR-04</text><text class="tiny" x="29" y="57">5,600 logged hours</text><rect class="process" x="171" y="37" width="134" height="24"/><text class="small mono" x="178" y="48">BP-1026-02 · BR-07</text><text class="tiny" x="178" y="57">5,600 logged hours</text><rect class="risk" x="320" y="34" width="164" height="30"/><text class="small mono" x="328" y="47">BP-1026-03 · BR-04</text><text class="tiny" x="328" y="57">19 Dec 2026 · vessel day 17</text><rect class="hold" x="505" y="37" width="160" height="24"/><text class="small mono" x="513" y="48">DEV-BP-1026-SUPPLIER</text><text class="tiny" x="513" y="57">run isolated · path on hold</text>
