<rect class="support" x="24" y="315" width="105" height="88"/><text class="title" x="32" y="332">Cleaning / waste</text><text class="small" x="32" y="347">Sampled controls</text><text class="tiny" x="32" y="360">acceptable; no incoming</text><text class="tiny" x="32" y="371">gasket or sanitation</text><text class="tiny" x="32" y="382">failure indicated</text>
