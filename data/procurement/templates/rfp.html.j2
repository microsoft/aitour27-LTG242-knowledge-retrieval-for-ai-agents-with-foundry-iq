{% extends "base.html.j2" %}
{% block title %}{{ rfp.document_id }} - {{ product.name }}{% endblock %}
{% macro chrome(page_no, section) %}<div class="topline"></div><header class="head"><div class="brand"><img src="{{ logo_uri }}" alt="Caldova Pharmaceuticals logo"><div><b>Caldova Pharmaceuticals</b><span>{{ corpus.department }}</span></div></div><div class="meta">{{ rfp.document_id }}<br>{{ section }} · Page {{ page_no }} of 4</div></header><footer class="footer"><span>{{ corpus.classification }}</span><span>{{ corpus.fictional_notice }}</span></footer>{% endmacro %}
{% block body %}
<section class="page">{{ chrome(1,'Solicitation') }}<div class="kicker">Request for proposal</div><h1>Commercial manufacture of<br>{{ product.name }}</h1><p class="lede">Caldova invites qualified contract manufacturers to propose a controlled technology transfer and reliable 12-month commercial supply program.</p><img class="hero" src="{{ suite_image_uri }}" alt="Synthetic oral solid dose manufacturing suite"><div class="grid3"><div class="card"><div class="label">Annual volume</div><div class="metric">{{ product.annual_volume|number }}</div><p>tablets across {{ product.annual_batches }} planned batches</p></div><div class="card"><div class="label">Response due</div><div class="metric" style="font-size:17pt">08 Oct 2026</div><p>17:00 Eastern Time</p></div><div class="card"><div class="label">First delivery</div><div class="metric" style="font-size:17pt">30 Apr 2027</div><p>subject to PPQ approval</p></div></div><div class="callout"><b>Issued by:</b> {{ corpus.department }} · {{ corpus.contact }} · {{ corpus.contact_email }}</div><p class="small">Image disclosure: the manufacturing-suite photograph is an original synthetic demonstration image. It does not depict an actual Caldova or supplier facility.</p></section>
<section class="page">{{ chrome(2,'Scope and schedule') }}<h2>1. Procurement scope</h2><p>{{ product.name }} is a fictional immediate-release product used to demonstrate retrieval across solicitation, bid, agreement, amendment, and order records. The successful supplier will provide technology transfer, GMP manufacture, testing, release, storage, and bulk preparation.</p><div class="grid2"><div><h3>Product profile</h3><table><tr><td>Specification</td><td>{{ product.specification_id }}</td></tr><tr><td>Batch size</td><td>{{ product.batch_size|number }} tablets</td></tr><tr><td>Monthly requirement</td><td>{{ product.monthly_volume|number }} tablets</td></tr><tr><td>Packaging</td><td>{{ product.packaging }}</td></tr><tr><td>Storage</td><td>{{ product.storage }}</td></tr><tr><td>Markets</td><td>{{ product.markets }}</td></tr></table></div><div><h3>Required services</h3><ul>{% for item in rfp.requirements %}<li>{{ item }}</li>{% endfor %}</ul></div></div><h3>Sourcing-to-supply flow</h3><div class="flow"><div class="step"><b>RFP</b><span>15 Sep 2026<br>requirements fixed</span></div><div class="step"><b>Responses</b><span>08 Oct 2026<br>comparable schedules</span></div><div class="step"><b>Evaluation</b><span>26 Oct 2026<br>gates and weights</span></div><div class="step"><b>Award</b><span>02 Nov 2026<br>executive approval</span></div><div class="step"><b>Transfer</b><span>23 Nov 2026<br>controlled start</span></div><div class="step"><b>Supply</b><span>30 Apr 2027<br>first delivery</span></div></div><h3>Procurement calendar</h3><table><tr><th>Milestone</th><th>Date</th><th>Control</th></tr><tr><td>Supplier questions due</td><td>{{ rfp.questions_due }}</td><td>Written questions to named contact</td></tr><tr><td>Responses due</td><td>{{ rfp.response_due }}</td><td>Late changes only by written clarification</td></tr><tr><td>Evaluation complete</td><td>{{ rfp.evaluation_complete }}</td><td>Quality and regulatory gates first</td></tr><tr><td>Award notice</td><td>{{ rfp.award_notice }}</td><td>Subject to contract amendment</td></tr></table></section>
<section class="page">{{ chrome(3,'Evaluation and response') }}<h2>2. Evaluation framework</h2><p>Qualification follows {{ corpus.policy_id }}, version {{ corpus.policy_version }}. Mandatory gates are applied before weighted award scoring. Lowest price alone does not determine award.</p><table><tr><th>Category</th><th>Weight</th><th>Evidence considered</th></tr>{% for item in rfp.weights %}<tr><td>{{ item.category }}</td><td>{{ item.weight }}%</td><td>{% if loop.index == 1 %}OSD experience, transfer method, process fit, documentation{% elif loop.index == 2 %}Inspection history, audit status, quality systems, release controls{% elif loop.index == 3 %}Firm capacity, lead time, safety stock, continuity{% elif loop.index == 4 %}Firm unit price, transfer fees, terms, total evaluated cost{% else %}Milestones, dependencies, subcontractors, financial resilience{% endif %}</td></tr>{% endfor %}</table><div class="callout warning"><h3>Mandatory gates</h3><ul>{% for gate in rfp.mandatory_gates %}<li>{{ gate }}</li>{% endfor %}</ul></div><div class="grid2"><div><h3>Required response sections</h3><ol>{% for section in rfp.submission_sections %}<li>{{ section }}</li>{% endfor %}</ol></div><div><h3>Commercial baseline</h3><ul><li>Firm USD pricing for 12 months</li><li>Net 60 payment terms</li><li>At least four weeks of safety stock</li><li>Written approval before subcontracting</li><li>No commencement before written authorization</li></ul></div></div><p class="small">Caldova may clarify, negotiate, reject any or all proposals, or discontinue this fictional process. Bid information is confidential and used only for this demonstration corpus.</p></section>
<section class="page">{{ chrome(4,'Schedules') }}<h2>3. Bid schedules</h2><h3>A. Technical and capacity schedule</h3><table><tr><th>Response field</th><th>Supplier commitment</th><th>Supporting evidence</th></tr><tr><td>Manufacturing and release site</td><td></td><td>Licenses and site master file</td></tr><tr><td>Firm monthly capacity</td><td></td><td>Capacity plan and utilization</td></tr><tr><td>Transfer and commercial lead time</td><td></td><td>Milestone plan</td></tr><tr><td>Safety stock</td><td></td><td>Inventory-control approach</td></tr><tr><td>Approved/proposed subcontractors</td><td></td><td>Scope and qualification status</td></tr></table><h3>B. Price schedule</h3><table><tr><th>Item</th><th>Unit</th><th>Firm quantity</th><th>Unit price USD</th><th>Extended price</th></tr><tr><td>Technology transfer</td><td>lot</td><td>1</td><td></td><td></td></tr><tr><td>{{ product.name }}</td><td>tablet</td><td>{{ product.annual_volume|number }}</td><td></td><td></td></tr><tr><td colspan="4"><b>Year-one evaluated total</b></td><td></td></tr></table><h3>C. Certification</h3><p>By signing, the supplier confirms that its response is accurate, valid for 120 days, free of undisclosed conflicts, and based on the requirements and exceptions stated in its submission.</p><div class="signature-grid"><div class="signature">Authorized supplier representative<br>Name / title / date</div><div class="signature">Caldova receipt<br>{{ corpus.contact }} / date</div></div><div class="callout"><b>Submission:</b> {{ corpus.contact_email }} · Subject: {{ rfp.document_id }} / supplier legal name</div></section>
{% endblock %}
