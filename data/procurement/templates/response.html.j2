{% extends "base.html.j2" %}
{% block title %}{{ supplier.response_id }} - {{ supplier.name }}{% endblock %}
{% macro chrome(page_no, section) %}<div class="topline"></div><header class="head"><div><div style="font-family:Georgia,serif;font-size:17pt;color:var(--accent)">{{ supplier.name }}</div><span class="small">Contract manufacturing proposal · {{ supplier.vendor_id }}</span></div><div class="meta">{{ supplier.response_id }}<br>{{ section }} · Page {{ page_no }} of 4</div></header><footer class="footer"><span>Confidential supplier response</span><span>{{ corpus.fictional_notice }}</span></footer>{% endmacro %}
{% block body %}
<section class="page">{{ chrome(1,'Offer') }}<div class="kicker">Response to {{ rfp.document_id }}</div><h1>{{ supplier.proposal_theme }}</h1><p class="lede">Proposal for technology transfer and 12-month commercial manufacture of {{ product.name }}.</p><div class="grid3" style="margin-top:.28in"><div class="card"><div class="label">Firm monthly capacity</div><div class="metric">{{ supplier.firm_capacity_monthly|number }}</div><p>tablets reserved</p></div><div class="card"><div class="label">Lead time</div><div class="metric">{{ supplier.lead_time_weeks }}</div><p>weeks</p></div><div class="card"><div class="label">Year-one total</div><div class="metric" style="font-size:18pt">{{ supplier.year_one_total|money }}</div><p>firm evaluated cost</p></div></div><div class="callout"><b>Legal entity / site:</b> {{ supplier.name }}, {{ supplier.location }}<br><b>Existing agreement:</b> {{ supplier.agreement_id }}, effective {{ supplier.agreement_effective }}<br><b>Offer date:</b> {{ supplier.response_date }} · Valid 120 days</div><h3>Executive commitment</h3><p>{{ supplier.name }} proposes to transfer Caldova's controlled process, reserve the capacity stated in this response, manufacture and release bulk tablets under cGMP, and provide the complete batch disposition package. Our offer accepts firm USD pricing, Net 60 payment, safety-stock obligations, and written approval for subcontracting, subject only to the stated exceptions.</p><div class="signature-grid"><div class="signature">Jamie Rowan<br>Vice President, Commercial Operations<br>{{ supplier.name }} · {{ supplier.response_date }}</div><div class="signature">Proposal control<br>{{ supplier.response_id }}<br>Submitted to {{ corpus.contact }}</div></div></section>
<section class="page">{{ chrome(2,'Capability') }}<h2>1. Technical, quality, and capacity response</h2><div class="grid3"><div class="card"><div class="label">OSD experience</div><div class="metric">{{ supplier.osd_experience_years }}</div><p>years</p></div><div class="card"><div class="label">Available capacity</div><div class="metric">{{ supplier.available_capacity_monthly|number }}</div><p>tablets/month</p></div><div class="card"><div class="label">Current utilization</div><div class="metric">{{ supplier.utilization_pct }}%</div><p>at proposed site</p></div></div><h3 style="margin-top:.18in">Manufacturing flow and control evidence</h3><div class="flow"><div class="step"><b>Dispense</b><span>identity and weight verification</span></div><div class="step"><b>Granulate</b><span>controlled endpoint and hold time</span></div><div class="step"><b>Compress</b><span>weight, hardness, friability</span></div><div class="step"><b>Coat</b><span>appearance and weight gain</span></div><div class="step"><b>Release</b><span>CoA, CoC, executed record</span></div></div><table><tr><th>Indicator</th><th>Current evidence</th><th>Proposal relevance</th></tr><tr><td>OTIF</td><td>{{ supplier.otif_pct }}%</td><td>Commercial delivery reliability</td></tr><tr><td>Batch rejection</td><td>{{ supplier.batch_rejection_pct }}%</td><td>Quality and process consistency</td></tr><tr><td>Right first time</td><td>{{ supplier.right_first_time_pct }}%</td><td>Documentation and execution control</td></tr><tr><td>Inspection status</td><td>{{ supplier.inspection_status }}</td><td>Regulatory history; {{ supplier.open_actions }} open actions</td></tr><tr><td>Caldova audit</td><td>{{ supplier.audit_status }}</td><td>Mandatory quality gate</td></tr><tr><td>Transfer success</td><td>{{ supplier.tech_transfer_success_pct }}%</td><td>Comparable program history</td></tr><tr><td>Financial rating</td><td>{{ supplier.financial_rating }}</td><td>Continuity and resilience</td></tr></table><div class="callout"><b>Safety stock:</b> {{ supplier.safety_stock_weeks }} weeks after launch. <b>Subcontractors:</b> {{ supplier.subcontractors }}</div></section>
<section class="page">{{ chrome(3,'Implementation') }}<h2>2. Technology-transfer plan</h2><p>The transfer plan uses controlled inputs and gated approval. No PPQ activity begins until methods, master records, cleaning strategy, critical materials, and deviations are approved.</p><div class="timeline"><div><b>Week 0 · Kickoff</b><br>Governance, document index, risk register, and responsibility matrix.</div><div><b>Weeks 1-4 · Knowledge transfer</b><br>{{ product.master_batch_record }}, {{ product.specification_id }}, process history, methods, and material controls.</div><div><b>Weeks 5-8 · Site adaptation</b><br>Equipment mapping, gap assessment, draft batch records, cleaning and sampling plans.</div><div><b>Weeks 9-12 · Method and engineering readiness</b><br>Analytical transfer, engineering protocol, raw-material qualification, operator training.</div><div><b>Weeks 13-{{ supplier.lead_time_weeks }} · Execution gate</b><br>Engineering batch review and PPQ readiness decision.</div></div><h3>Responsibilities</h3><table><tr><th>Workstream</th><th>Caldova</th><th>{{ supplier.name }}</th></tr><tr><td>Product knowledge</td><td>Specifications, history, methods, MBR inputs</td><td>Gap assessment and receiving-site procedures</td></tr><tr><td>Materials</td><td>Approve critical sources</td><td>Qualify, procure, sample, test, inventory</td></tr><tr><td>Validation</td><td>Approve strategy and protocols</td><td>Draft and execute approved protocols</td></tr><tr><td>Release</td><td>Final disposition for Caldova use</td><td>Site quality disposition and complete release package</td></tr></table><div class="callout warning"><b>Principal implementation risk:</b> {{ supplier.risk }}</div><p><b>Exception:</b> {{ supplier.exceptions }}</p></section>
<section class="page">{{ chrome(4,'Commercial schedule') }}<h2>3. Firm price and declarations</h2><table><tr><th>Line</th><th>Description</th><th>Quantity</th><th>Unit price</th><th>Extended</th></tr><tr><td>1</td><td>Technology-transfer package</td><td>1 lot</td><td>{{ supplier.tech_transfer_fee|money }}</td><td>{{ supplier.tech_transfer_fee|money }}</td></tr><tr><td>2</td><td>{{ product.name }}</td><td>{{ product.annual_volume|number }} tablets</td><td>{{ supplier.unit_price|money }}</td><td>{{ supplier.annual_product_cost|money }}</td></tr><tr><td colspan="4"><b>Year-one evaluated total</b></td><td><b>{{ supplier.year_one_total|money }}</b></td></tr></table><div class="grid2"><div class="card"><h3>Commercial terms</h3><ul><li>Currency: USD</li><li>Price validity: 12-month firm period</li><li>Payment: Net 60</li><li>MOQ: {{ supplier.minimum_order_qty|number }} tablets</li><li>Capacity reservation: {{ supplier.firm_capacity_monthly|number }} tablets/month</li></ul></div><div class="card"><h3>Offer disclosures</h3><p><b>Subcontractors:</b> {{ supplier.subcontractors }}</p><p><b>Exceptions:</b> {{ supplier.exceptions }}</p></div></div><h3 style="margin-top:.18in">Attestation</h3><p>We certify that this response is complete and accurate to the best of our knowledge; that no undisclosed conflict, inducement, or coordinated bid affected it; and that all commitments and exceptions are stated here or in referenced schedules.</p><div class="signature-grid"><div class="signature">Jamie Rowan<br>Vice President, Commercial Operations<br>{{ supplier.name }}</div><div class="signature">Morgan Lee<br>Head of Quality<br>{{ supplier.name }}</div></div><p class="notice">Synthetic signature blocks are typed for demo use and do not represent real persons or authorization.</p></section>
{% endblock %}
