{% extends "base.html.j2" %}
{% block title %}{{ purchase_order.document_id }} - Purchase order{% endblock %}
{% macro chrome(page_no, section) %}<div class="topline"></div><header class="head"><div class="brand"><img src="{{ logo_uri }}" alt="Caldova Pharmaceuticals logo"><div><b>Purchase order</b><span>Global Strategic Sourcing, Manufacturing & External Supply</span></div></div><div class="meta">{{ purchase_order.document_id }}<br>{{ section }} · Page {{ page_no }} of 2</div></header><footer class="footer"><span>Controlled purchasing record</span><span>{{ corpus.fictional_notice }}</span></footer>{% endmacro %}
{% block body %}
<section class="page">{{ chrome(1,'Order') }}<div class="grid2"><div><div class="kicker">Order for services and product</div><h1>{{ purchase_order.document_id }}</h1></div><div class="card"><table style="margin:0"><tr><td>Issue date</td><td><b>{{ purchase_order.issue_date }}</b></td></tr><tr><td>Requisition</td><td>{{ purchase_order.requisition_id }}</td></tr><tr><td>Currency</td><td>{{ purchase_order.currency }}</td></tr><tr><td>Terms</td><td>{{ purchase_order.payment_terms }}</td></tr></table></div></div><div class="grid2" style="margin-top:.18in"><div class="card"><h3>Supplier</h3><p><b>{{ purchase_order.supplier }}</b> · {{ purchase_order.vendor_id }}<br>North Carolina, USA</p></div><div class="card"><h3>Ship to</h3><p>{{ purchase_order.ship_to }}</p></div><div class="card"><h3>Bill to</h3><p>{{ purchase_order.bill_to }}</p></div><div class="card"><h3>Contract basis</h3><p>{{ purchase_order.agreement_id }}<br>{{ purchase_order.amendment_id }}</p></div></div><table style="margin-top:.2in"><tr><th>Line</th><th>Description</th><th>Quantity / unit</th><th>Unit price</th><th>Amount</th><th>Delivery</th></tr>{% for line in purchase_order.lines %}<tr><td>{{ line.line }}</td><td>{{ line.description }}</td><td>{{ line.quantity|number }} {{ line.unit }}</td><td>{{ line.unit_price|money }}</td><td>{{ line.amount|money }}</td><td>{{ line.delivery }}</td></tr>{% endfor %}<tr><td colspan="4" style="text-align:right"><b>Subtotal</b></td><td colspan="2">{{ purchase_order.subtotal|money }}</td></tr><tr><td colspan="4" style="text-align:right"><b>Tax</b></td><td colspan="2">{{ purchase_order.tax|money }}</td></tr><tr><td colspan="4" style="text-align:right;font-size:10pt"><b>Total order value</b></td><td colspan="2" style="font-size:11pt;color:var(--accent)"><b>{{ purchase_order.total|money }}</b></td></tr></table><div class="callout"><b>Incoterm:</b> {{ purchase_order.incoterm }}<br><b>Supplier acknowledgment:</b> {{ purchase_order.acceptance }}</div></section>
<section class="page">{{ chrome(2,'Instructions and authorization') }}<h2>1. Batch and delivery instructions</h2><div class="grid2"><div class="card"><h3>Packaging and transport</h3><p>{{ purchase_order.shipping_instructions }}</p></div><div class="card"><h3>Required release package</h3><p>{{ purchase_order.required_documents }}</p></div></div><h3 style="margin-top:.2in">Document authority chain</h3><div class="doc-chain"><span>{{ purchase_order.rfp_id }}<br><small>requirements</small></span><b>›</b><span>{{ purchase_order.response_id }}<br><small>supplier offer</small></span><b>›</b><span>{{ purchase_order.agreement_id }}<br><small>framework terms</small></span><b>›</b><span>{{ purchase_order.amendment_id }}<br><small>award schedule</small></span><b>›</b><span>{{ purchase_order.document_id }}<br><small>quantities and dates</small></span></div><h2>2. Quality and acceptance</h2><ul><li>All manufacture and testing must comply with {{ product.specification_id }}, the approved master batch record, the Quality Agreement, cGMP, and the amended agreement.</li><li>Kristos quality-unit release does not replace Caldova's final disposition for use.</li><li>Any deviation potentially affecting identity, strength, quality, purity, data integrity, delivery, or regulatory commitments requires prompt written notice.</li><li>No substitution of materials, site, equipment train, test method, or subcontractor without approved change control.</li><li>Caldova may quarantine or reject nonconforming product under {{ purchase_order.agreement_id }}.</li></ul><h2>3. Commercial controls</h2><p>Invoices must quote this PO and line number, identify the relevant batch or approved milestone, and include required evidence. Only quantities and charges shown here are authorized. Taxes, freight, storage, surcharges, or pass-through expenses require explicit written authorization.</p><div class="signature-grid"><div class="signature"><b>Authorized for Caldova</b><br>{{ purchase_order.authorization }}<br>{{ purchase_order.issue_date }}</div><div class="signature"><b>Supplier acknowledgment</b><br>Alex Mercer · Kristos Pharma<br>Date: __________________</div></div><p class="notice">This order is fictional demonstration data. It creates no real financial or legal obligation.</p></section>
{% endblock %}
