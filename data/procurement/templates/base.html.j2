<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{% block title %}{% endblock %}</title>
<style>
  :root { --ink:#18252d; --muted:#61717b; --paper:#f8faf9; --line:#c9d4d7; --caldova:#006b62; --gold:#c49a43; --accent:{{ supplier.accent if supplier is defined else '#006b62' }}; }
  * { box-sizing:border-box; }
  @page { size:Letter; margin:0; }
  body { margin:0; color:var(--ink); font-family:"Aptos","Helvetica Neue",Arial,sans-serif; background:#d8dfe0; line-height:1.38; }
  .page { position:relative; width:8.5in; min-height:11in; padding:.62in .66in .58in; margin:0 auto; background:var(--paper); page-break-after:always; overflow:hidden; }
  .page:last-child { page-break-after:auto; }
  .topline { height:5px; background:linear-gradient(90deg,var(--accent) 0 74%,var(--gold) 74%); margin:-.62in -.66in .28in; }
  .head { display:flex; justify-content:space-between; align-items:flex-start; border-bottom:1px solid var(--line); padding-bottom:.12in; margin-bottom:.22in; }
  .brand { display:flex; gap:.12in; align-items:center; }
  .brand img { width:.52in; height:.52in; object-fit:contain; }
  .brand b { display:block; font-size:10pt; letter-spacing:.04em; text-transform:uppercase; color:var(--accent); }
  .brand span,.meta { color:var(--muted); font-size:7.8pt; }
  .meta { text-align:right; line-height:1.45; }
  .footer { position:absolute; left:.66in; right:.66in; bottom:.25in; display:flex; justify-content:space-between; color:#6e7c84; font-size:7.2pt; border-top:1px solid var(--line); padding-top:.07in; }
  h1,h2,h3 { margin:0; line-height:1.12; }
  h1 { font-family:Georgia,serif; font-size:28pt; font-weight:500; letter-spacing:0; }
  h2 { font-size:15pt; color:var(--accent); margin-bottom:.12in; }
  h3 { font-size:10.5pt; text-transform:uppercase; letter-spacing:.05em; color:var(--accent); margin-bottom:.07in; }
  p { font-size:9pt; margin:.05in 0 .12in; }
  .kicker { color:var(--accent); font-size:8pt; text-transform:uppercase; letter-spacing:.12em; font-weight:700; margin-bottom:.08in; }
  .lede { font-family:Georgia,serif; font-size:13pt; color:#35464f; max-width:6.6in; }
  .hero { width:100%; height:2.3in; object-fit:cover; margin:.2in 0; border-bottom:6px solid var(--accent); }
  .grid2 { display:grid; grid-template-columns:1fr 1fr; gap:.2in; }
  .grid3 { display:grid; grid-template-columns:repeat(3,1fr); gap:.14in; }
  .card { border:1px solid var(--line); border-top:4px solid var(--accent); padding:.15in; background:#fff; }
  .callout { background:#eaf2f0; border-left:5px solid var(--accent); padding:.13in .16in; margin:.12in 0; }
  .warning { background:#fff6df; border-left-color:#b47513; }
  .metric { font-family:Georgia,serif; font-size:22pt; color:var(--accent); }
  .label { font-size:7.4pt; color:var(--muted); text-transform:uppercase; letter-spacing:.06em; }
  table { width:100%; border-collapse:collapse; margin:.1in 0 .18in; font-size:8pt; }
  th { background:var(--accent); color:#fff; text-align:left; padding:.07in .08in; font-weight:600; }
  td { border-bottom:1px solid var(--line); padding:.065in .08in; vertical-align:top; }
  tr:nth-child(even) td { background:#f0f4f3; }
  ul,ol { margin:.06in 0 .14in; padding-left:.22in; font-size:8.7pt; }
  li { margin:.035in 0; }
  .flow { display:flex; align-items:stretch; gap:.08in; margin:.17in 0; }
  .flow .step { flex:1; position:relative; background:#fff; border:1px solid var(--line); border-top:4px solid var(--accent); padding:.12in .1in; min-height:.82in; }
  .flow .step:not(:last-child)::after { content:'›'; position:absolute; right:-.08in; top:.2in; color:var(--gold); font-size:24pt; z-index:2; }
  .step b { display:block; color:var(--accent); font-size:8.5pt; }
  .step span { font-size:7.2pt; color:var(--muted); }
  .timeline { display:grid; grid-template-columns:1fr; gap:.08in; border-left:3px solid var(--accent); margin:.14in 0 .14in .08in; padding-left:.18in; }
  .timeline div { position:relative; font-size:8pt; }
  .timeline div::before { content:''; width:9px; height:9px; border-radius:50%; background:var(--gold); position:absolute; left:-.235in; top:.04in; }
  .scorebar { height:.13in; background:#dce5e4; margin-top:.04in; }
  .scorebar i { display:block; height:100%; background:var(--accent); }
  .signature-grid { display:grid; grid-template-columns:1fr 1fr; gap:.35in; margin-top:.28in; }
  .signature { border-top:1px solid var(--ink); padding-top:.07in; font-size:8pt; min-height:.65in; }
  .small { font-size:7.4pt; color:var(--muted); }
  .pill { display:inline-block; padding:.03in .08in; border:1px solid var(--accent); color:var(--accent); font-size:7pt; font-weight:700; text-transform:uppercase; }
  .doc-chain { display:flex; gap:.05in; align-items:center; flex-wrap:wrap; margin:.12in 0; }
  .doc-chain span { border:1px solid var(--line); padding:.06in .08in; background:#fff; font-size:7.2pt; }
  .doc-chain b { color:var(--gold); }
  .legal p { font-family:Georgia,serif; font-size:8.4pt; text-align:justify; }
  .legal h2 { border-bottom:1px solid var(--line); padding-bottom:.05in; margin-top:.08in; }
  .notice { font-size:7pt; color:#6f5721; background:#fff5d7; padding:.05in .08in; display:inline-block; }
</style>
</head>
<body>{% block body %}{% endblock %}</body>
</html>
