<!doctype html>
<html lang="en"><head><meta charset="utf-8"><title>{{ packet.assessment_id }} - Quality assessment</title>{% include "_styles.html.j2" %}</head>
<body class="assessment"><main class="page">
<header class="header"><img class="logo" src="{{ caldova_logo_uri }}" alt="Caldova"><div class="doc"><h1>{% if packet.kind == "yield" %}Yield true-up assessment{% elif packet.kind == "inspection" %}Nonconformance and scrap disposition{% else %}Contamination deviation investigation{% endif %}</h1><div class="id">{{ packet.assessment_id }}</div><span class="pill">Final</span></div></header>
<section class="meta"><div><span class="label">Supplier</span><span class="value">{{ packet.supplier_name }}</span></div><div><span class="label">Primary evidence</span><span class="value">{{ packet.evidence_id }}</span></div><div><span class="label">Invoice line</span><span class="value">{{ packet.invoice_line_id }}</span></div><div><span class="label">Review date</span><span class="value">{{ packet.dates.reviewed }}</span></div></section>
{% if packet.kind == "yield" %}
<section class="metrics"><div class="metric"><span class="label">Forecast output</span><b>{{ packet.forecast.forecast_released_kg|number }} kg</b></div><div class="metric"><span class="label">Actual release</span><b>{{ packet.overall.released_kg|number }} kg</b></div><div class="metric"><span class="label">Claimed variance</span><b>{{ packet.forecast.variance_kg|number }} kg</b></div><div class="metric"><span class="label">Claimed true-up</span><b>{{ packet.forecast.claimed_adjustment|money }}</b></div></section>
<h2>Scope and evidence reviewed</h2><p>This assessment reconciles invoice reference {{ packet.related_ids[2] }} against actual lot evidence for {{ packet.lot_id }}. Records reviewed: {{ packet.evidence_id }}, {{ packet.related_ids[0] }}, {{ packet.related_ids[1] }}, {{ packet.related_ids[3] }}, and invoice {{ packet.invoice_id }}.</p>
<h2>Reconciliation</h2><table><thead><tr><th>Test</th><th>Source</th><th>Result</th></tr></thead><tbody><tr><td>Actual released quantity</td><td>{{ packet.evidence_id }} / {{ packet.related_ids[0] }}</td><td>{{ packet.overall.released_kg|number }} kg</td></tr><tr><td>Approved yield range</td><td>Lot control record</td><td>{{ packet.overall.yield_percent }}%; within {{ packet.overall.approved_range_low|int }}-{{ packet.overall.approved_range_high|int }}%</td></tr><tr><td>Forecast calculation</td><td>{{ packet.related_ids[2] }}</td><td>{{ packet.forecast.forecast_released_kg|number }} kg less {{ packet.overall.released_kg|number }} kg x {{ packet.forecast.rate_per_kg|money }} = {{ packet.forecast.claimed_adjustment|money }}</td></tr><tr><td>Duplicate billing check</td><td>{{ packet.invoice_id }} L001</td><td>Actual released quantity already billed</td></tr></tbody></table>
{% set a = packet.assessment %}
{% elif packet.kind == "inspection" %}
<section class="metrics"><div class="metric"><span class="label">Built</span><b>{{ packet.summary.built|number }}</b></div><div class="metric"><span class="label">Actual scrap</span><b>{{ packet.summary.scrapped|number }}</b></div><div class="metric"><span class="label">Allowed scrap</span><b>{{ packet.summary.allowed_scrap|number }}</b></div><div class="metric"><span class="label">Excess</span><b>{{ packet.summary.excess_scrap|number }}</b></div></section>
<h2>Nonconformance statement</h2><p>{{ packet.assessment.finding }} The affected records are {{ packet.evidence_id }}, {{ packet.related_ids[0] }}, and {{ packet.related_ids[3] }}.</p>
<div class="grid2"><div><h2>Defect evidence</h2><table><thead><tr><th>Code</th><th>Severity</th><th class="num">Quantity</th></tr></thead><tbody>{% for defect in packet.defects %}<tr><td>{{ defect.code }}</td><td>{{ defect.severity }}</td><td class="num">{{ defect.quantity|number }}</td></tr>{% endfor %}</tbody></table></div><figure class="figure" aria-labelledby="cause-title"><figcaption id="cause-title" class="figure-title">Figure 1. Cause-to-loss relationship</figcaption><svg class="fishbone" role="img" aria-labelledby="cause-svg-title cause-svg-desc" viewBox="0 0 330 120"><title id="cause-svg-title">Cause-to-loss diagram</title><desc id="cause-svg-desc">Fixture wear and setup verification gaps lead to assembly defects; label datum drift leads to label defects; both contribute to excess scrap.</desc><line x1="38" y1="60" x2="294" y2="60" stroke="#263d59" stroke-width="3"/><path d="M294 60 l-15 -8 v16 z" fill="#263d59"/><g stroke="#7a3030" stroke-width="2"><line x1="92" y1="60" x2="62" y2="25"/><line x1="150" y1="60" x2="120" y2="96"/><line x1="210" y1="60" x2="180" y2="25"/></g><g font-size="8" fill="#18232a"><text x="16" y="18">Fixture wear</text><text x="80" y="108">Setup check gap</text><text x="144" y="18">Label datum drift</text><text x="252" y="85">Excess scrap</text></g></svg></figure></div>
<h2>Sponsor-cause review</h2><p>{{ packet.assessment.sponsor_cause_review }}</p>
{% set a = packet.assessment %}
{% else %}
<section class="metrics"><div class="metric"><span class="label">Affected run</span><b style="font-size:14px">{{ packet.deviation.affected_run }}</b></div><div class="metric"><span class="label">Event date</span><b style="font-size:14px">{{ packet.deviation.event_date }}</b></div><div class="metric"><span class="label">Classification</span><b style="font-size:14px">Major</b></div><div class="metric"><span class="label">Claimed fee</span><b>{{ packet.deviation.investigation_cost|money }}</b></div></section>
<h2>Event description and containment</h2><p><b>Detection:</b> {{ packet.deviation.detected_by }}. The isolate was identified as <i>{{ packet.deviation.organism }}</i>.</p><p><b>Immediate action:</b> {{ packet.deviation.immediate_action }}</p>
<div class="grid2"><div><h2>Evidence reviewed</h2><ul>{% for item in packet.deviation.evidence %}<li>{{ item }}</li>{% endfor %}</ul></div><figure class="figure" aria-labelledby="path-title"><figcaption id="path-title" class="figure-title">Figure 1. Contamination localization</figcaption><svg class="fishbone" role="img" aria-labelledby="path-svg-title path-svg-desc" viewBox="0 0 330 120"><title id="path-svg-title">Transfer path contamination localization</title><desc id="path-svg-desc">Upstream retained sample was negative. The TC-4 transfer connection had a pinched gasket. Downstream and vessel samples were positive.</desc><defs><marker id="arrow" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto"><path d="M0,0 L8,4 L0,8 z" fill="#263d59"/></marker></defs><line x1="38" y1="60" x2="292" y2="60" stroke="#263d59" stroke-width="3" marker-end="url(#arrow)"/><g font-size="8" text-anchor="middle"><circle cx="55" cy="60" r="15" fill="#d8ece0" stroke="#31724c"/><text x="55" y="63">NEG</text><circle cx="165" cy="60" r="19" fill="#f7dfb2" stroke="#c48218"/><text x="165" y="58">TC-4</text><text x="165" y="68">GASKET</text><circle cx="275" cy="60" r="15" fill="#f4d4d1" stroke="#a83a34"/><text x="275" y="63">POS</text><text x="55" y="94">Upstream</text><text x="165" y="94">Failure point</text><text x="275" y="94">Vessel</text></g></svg></figure></div>
<h2>Root cause and responsibility</h2><p>{{ packet.deviation.root_cause }}</p><p><b>Sponsor-cause review:</b> {{ packet.deviation.sponsor_cause_review }}</p>
{% set a = packet.deviation %}
{% endif %}
<div class="grid2"><div><h2>Root cause conclusion</h2><p>{{ a.root_cause }}</p></div><div><h2>Impact assessment</h2><p>{% if packet.kind == "yield" %}{{ a.impact }}{% elif packet.kind == "inspection" %}Accepted units remain conforming and released. Excess scrap is attributable to supplier process controls.{% else %}The affected run remained isolated and no released product was impacted. The investigation is supplier-responsible.{% endif %}</p></div></div>
<h2>Corrective and preventive actions</h2><table><thead><tr><th>Action</th><th>Owner</th><th>Due</th></tr></thead><tbody>{% for action in a.actions %}<tr><td>{{ action }}</td><td>{{ packet.supplier_name }} Quality</td><td>{% if loop.index == 1 %}Complete{% else %}30 days{% endif %}</td></tr>{% endfor %}</tbody></table>
<div class="decision"><div><span class="label">Final disposition</span><strong>{{ a.decision }}</strong></div><div style="text-align:right"><span class="label">Approved invoice amount</span><strong>{{ a.approved_amount|money }}</strong><div class="small">Claimed: {{ packet.invoice_amount|money }}</div></div></div>
<section class="signatures"><div class="signature"><b>Mara Chen</b><br><span class="small">Caldova Quality</span></div><div class="signature"><b>Jon Bell</b><br><span class="small">Caldova Finance</span></div><div class="signature"><b>Elena Ruiz</b><br><span class="small">Supplier Quality</span></div></section>
<footer class="footer"><span>Caldova | Quality and invoice assessment</span><span>{{ packet.assessment_id }} | {{ packet.invoice_id }}</span></footer>
</main></body></html>
