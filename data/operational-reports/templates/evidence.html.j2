<!doctype html>
<html lang="en"><head><meta charset="utf-8"><title>{{ packet.evidence_id }} - {{ packet.title }}</title>{% include "_styles.html.j2" %}</head>
<body class="{{ packet.kind }}"><main class="page">
<header class="header"><img class="logo" src="{{ supplier_logo_uri }}" alt="{{ packet.supplier_name }}"><div class="doc"><h1>{{ packet.title }}</h1><div class="id">{{ packet.evidence_id }}</div><span class="pill">Controlled record</span></div></header>
{% if packet.kind == "yield" %}
<section class="meta"><div><span class="label">Material</span><span class="value">{{ packet.material }}</span></div><div><span class="label">Lot</span><span class="value">{{ packet.lot_id }}</span></div><div><span class="label">Manufacturing period</span><span class="value">{{ packet.dates.manufacturing_start }} to {{ packet.dates.manufacturing_end }}</span></div><div><span class="label">Certificate</span><span class="value">{{ packet.related_ids[0] }}</span></div></section>
<section class="metrics"><div class="metric"><span class="label">Charged mass</span><b>{{ packet.overall.charged_kg|number }} kg</b></div><div class="metric"><span class="label">Released mass</span><b>{{ packet.overall.released_kg|number }} kg</b></div><div class="metric"><span class="label">Overall yield</span><b>{{ packet.overall.yield_percent }}%</b></div><div class="metric"><span class="label">Approved range</span><b>{{ packet.overall.approved_range_low|int }}-{{ packet.overall.approved_range_high|int }}%</b></div></section>
<h2>Stage reconciliation</h2><table><thead><tr><th>Process stage</th><th class="num">Input (kg)</th><th class="num">Output (kg)</th><th class="num">Stage yield</th></tr></thead><tbody>{% for stage in packet.stages %}<tr><td>{{ stage.name }}</td><td class="num">{{ stage.input_kg|number }}</td><td class="num">{{ stage.output_kg|number }}</td><td class="num">{{ stage.yield_percent }}%</td></tr>{% endfor %}</tbody></table>
<figure class="figure" aria-labelledby="yield-title"><figcaption id="yield-title" class="figure-title">Figure 1. Reconciled mass by process stage</figcaption><svg role="img" aria-labelledby="yield-svg-title yield-svg-desc" width="0" height="0"><title id="yield-svg-title">Lot mass reconciliation</title><desc id="yield-svg-desc">Bars decline from 8,200 kilograms charged to 7,200 kilograms released, an overall yield of 87.8 percent.</desc></svg>{% for row in figure_rows %}<div class="bar-row"><span>{{ row.name }}</span><div class="track"><div class="bar" style="width:{{ row.bar_width }}%"></div></div><b class="num">{{ row.output_kg|number }} kg</b></div>{% endfor %}</figure>
<div class="note"><b>Release statement.</b> Actual yield is within the approved 85-92% range. Released quantity is supported by {{ packet.related_ids[0] }} and is the quantity eligible for lot billing.</div>
{% elif packet.kind == "inspection" %}
<section class="meta"><div><span class="label">Build</span><span class="value">{{ packet.build_id }}</span></div><div><span class="label">Inspection</span><span class="value">{{ packet.inspection_id }}</span></div><div><span class="label">Lots</span><span class="value">{{ packet.lots[0].lot_id }}, {{ packet.lots[1].lot_id }}</span></div><div><span class="label">Inspection period</span><span class="value">{{ packet.dates.inspection_start }} to {{ packet.dates.inspection_end }}</span></div></section>
<section class="metrics"><div class="metric"><span class="label">Built</span><b>{{ packet.summary.built|number }}</b></div><div class="metric"><span class="label">Accepted</span><b>{{ packet.summary.accepted|number }}</b></div><div class="metric"><span class="label">Scrapped</span><b>{{ packet.summary.scrapped|number }}</b></div><div class="metric"><span class="label">Scrap rate</span><b>{{ packet.summary.scrap_percent }}%</b></div></section>
<h2>Lot disposition</h2><table><thead><tr><th>Lot</th><th class="num">Built</th><th class="num">Accepted</th><th class="num">Scrapped</th><th>Status</th></tr></thead><tbody>{% for lot in packet.lots %}<tr><td>{{ lot.lot_id }}</td><td class="num">{{ lot.built|number }}</td><td class="num">{{ lot.accepted|number }}</td><td class="num">{{ lot.scrapped|number }}</td><td>Accepted quantity released</td></tr>{% endfor %}</tbody></table>
<div class="grid2"><figure class="figure" aria-labelledby="defect-title"><figcaption id="defect-title" class="figure-title">Figure 1. Defect Pareto by quantity</figcaption>{% for row in figure_rows %}<div class="bar-row" style="grid-template-columns:120px 1fr 36px"><span>{{ row.code }} {{ row.name }}</span><div class="track"><div class="bar" style="width:{{ row.bar_width }}%"></div></div><b>{{ row.quantity|number }}</b></div>{% endfor %}</figure><figure class="figure" aria-labelledby="map-title"><figcaption id="map-title" class="figure-title">Figure 2. Representative defect locations</figcaption><svg class="device-map" role="img" aria-labelledby="map-svg-title map-svg-desc" viewBox="0 0 310 126"><title id="map-svg-title">Auto-injector defect location diagram</title><desc id="map-svg-desc">Technical side view marking the rear clip, housing surface, needle shield, and label datum.</desc><rect x="52" y="42" width="205" height="43" rx="20" fill="#e8edf0" stroke="#263d59" stroke-width="2"/><rect x="90" y="49" width="92" height="29" fill="#fff" stroke="#607078"/><path d="M257 51 L285 63 L257 76 Z" fill="#b9c6cc" stroke="#263d59"/><rect x="35" y="51" width="25" height="26" rx="4" fill="#b9c6cc" stroke="#263d59"/><g fill="#a83a34" stroke="#fff" stroke-width="1"><circle cx="49" cy="63" r="7"/><circle cx="75" cy="48" r="7"/><circle cx="277" cy="63" r="7"/><circle cx="136" cy="75" r="7"/></g><g font-size="7" fill="#18232a"><text x="8" y="22">Rear clip</text><line x1="48" y1="51" x2="34" y2="25" stroke="#18232a"/><text x="57" y="15">Housing mark</text><line x1="75" y1="41" x2="84" y2="18" stroke="#18232a"/><text x="246" y="20">Needle shield</text><line x1="277" y1="56" x2="271" y2="24" stroke="#18232a"/><text x="112" y="112">Label datum</text><line x1="136" y1="82" x2="136" y2="104" stroke="#18232a"/></g></svg></figure></div>
<div class="alert"><b>Inspection exception.</b> The 7,000 scrapped units equal {{ packet.summary.scrap_percent }}% of the build and exceed the contractual {{ packet.summary.allowance_percent }}% allowance. See {{ packet.assessment_id }}.</div>
{% else %}
<section class="meta"><div><span class="label">Capacity record</span><span class="value">{{ packet.capacity_id }}</span></div><div><span class="label">Campaign</span><span class="value">{{ packet.batch_id }}</span></div><div><span class="label">Run log</span><span class="value">{{ packet.run_id }}</span></div><div><span class="label">Period</span><span class="value">{{ packet.dates.period_start }} to {{ packet.dates.period_end }}</span></div></section>
<section class="metrics"><div class="metric"><span class="label">Reserved</span><b>{{ packet.capacity.reserved_hours|number }} h</b></div><div class="metric"><span class="label">Included</span><b>{{ packet.capacity.included_hours|number }} h</b></div><div class="metric"><span class="label">Utilized</span><b>{{ packet.capacity.utilized_hours|number }} h</b></div><div class="metric"><span class="label">Utilization</span><b>{{ packet.capacity.utilization_percent }}%</b></div></section>
<figure class="figure" aria-labelledby="capacity-title"><figcaption id="capacity-title" class="figure-title">Figure 1. Reserved capacity consumption</figcaption><svg role="img" aria-labelledby="cap-svg-title cap-svg-desc" width="0" height="0"><title id="cap-svg-title">Reserved capacity consumption</title><desc id="cap-svg-desc">Of 18,000 reserved hours, 12,000 were included and 4,800 were billable excess, leaving 1,200 unused.</desc></svg><div class="capacity-track"><div class="capacity-included" style="width:{{ included_width }}%">12,000 h included</div><div class="capacity-excess" style="width:{{ excess_width }}%">4,800 h excess</div></div><div class="small">0 h <span style="float:right">18,000 h reserved</span></div></figure>
<h2>Campaign run log</h2><table><thead><tr><th>Run</th><th>Suite</th><th>Start</th><th>End</th><th class="num">Occupied hours</th><th>Status</th></tr></thead><tbody>{% for run in packet.runs %}<tr><td>{{ run.run }}</td><td>{{ run.suite }}</td><td>{{ run.start }}</td><td>{{ run.end }}</td><td class="num">{{ run.hours|number }}</td><td>{{ run.status }}</td></tr>{% endfor %}</tbody></table>
<div class="grid2" style="margin-top:10px"><div class="note"><h3>Excess-capacity reconciliation</h3><p>{{ packet.capacity.excess_hours|number }} hours x {{ packet.capacity.excess_rate|money }} = <b>{{ packet.capacity.excess_amount|money }}</b></p><p>Supported by invoice reference {{ packet.run_id }}.</p></div><div class="alert"><h3>Deviation link</h3><p>Run {{ packet.deviation.affected_run }} was accepted with deviation after an in-process bioburden positive.</p><p>See {{ packet.assessment_id }} and {{ packet.related_ids[1] }}.</p></div></div>
{% endif %}
<footer class="footer"><span>{{ packet.supplier_name }} | Confidential quality record</span><span>{{ packet.evidence_id }} | Invoice {{ packet.invoice_id }}</span></footer>
</main></body></html>
