<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <title>{{ document.certificate_id }} — {{ document.title }}</title>
  <style>
    @page { size: Letter portrait; margin: 0; }
    * { box-sizing: border-box; }
    :root { --cobalt:#1746a2; --cobalt2:#5876b7; --red:#bd2d38; --ink:#20242b; --gray:#68707d; --line:#aeb7c8; --paper:#fbfaf5; --wash:#eef1f7; }
    html, body { margin:0; padding:0; font-family:"Helvetica Neue",Helvetica,sans-serif; color:var(--ink); }
    .page { width:8.5in; height:11in; position:relative; overflow:hidden; background:var(--paper); break-after:page; page-break-after:always; }
    .page:last-child { break-after:auto; page-break-after:auto; }
    .top-band { position:absolute; top:0; bottom:0; left:0; width:.16in; background:var(--cobalt); }
    .header { height:.98in; margin:0 .58in 0 .72in; display:flex; justify-content:space-between; align-items:center; border-bottom:3px double var(--cobalt); }
    .logo { width:1.45in; max-height:.42in; object-fit:contain; object-position:left center; filter:grayscale(1) contrast(1.15); }
    .header-meta { text-align:right; font-family:"Courier New",monospace; font-size:6.8pt; line-height:1.45; color:var(--gray); }
    .header-meta b { display:block; color:var(--ink); font-family:"Helvetica Neue",Helvetica,sans-serif; font-size:8pt; text-transform:uppercase; }
    .content { position:absolute; left:.72in; right:.58in; top:1.28in; bottom:.62in; }
    .footer { position:absolute; left:.72in; right:.58in; bottom:.25in; display:flex; justify-content:space-between; font-family:"Courier New",monospace; font-size:6.4pt; color:var(--gray); border-top:1px solid var(--cobalt2); padding-top:5px; }
    .notice { color:var(--red); font-weight:800; letter-spacing:.4px; }
    h1 { margin:0; font-family:Georgia,"Times New Roman",serif; font-size:32pt; font-weight:400; line-height:1; color:var(--ink); letter-spacing:0; }
    h2 { margin:0 0 10px; font-family:Georgia,"Times New Roman",serif; font-size:18pt; font-weight:400; color:var(--ink); letter-spacing:0; }
    h3 { margin:0 0 6px; font-size:7.8pt; color:var(--cobalt); text-transform:uppercase; letter-spacing:.7px; }
    p { margin:0 0 9px; font-size:8.6pt; line-height:1.35; }
    .eyebrow { color:var(--cobalt); font-family:"Courier New",monospace; font-size:7.2pt; font-weight:700; text-transform:uppercase; margin-bottom:7px; letter-spacing:.5px; }
    .hero { display:grid; grid-template-columns:1fr 2.15in; gap:.35in; align-items:end; margin-bottom:.28in; }
    .status { color:var(--red); padding:.14in .18in; border:3px double var(--red); transform:rotate(-1deg); text-align:center; background:transparent; }
    .status span { display:block; font-family:"Courier New",monospace; font-size:6.7pt; text-transform:uppercase; letter-spacing:1px; }
    .status b { font-family:"Courier New",monospace; font-size:19pt; letter-spacing:1px; }
    .identity-grid { display:grid; grid-template-columns:1fr 1fr; gap:.18in; }
    .panel { border:0; border-left:3px solid var(--cobalt); padding:.05in .18in .08in .16in; }
    .field-grid { display:grid; grid-template-columns:1fr 1fr; border-top:1px solid var(--line); }
    .field { min-height:.52in; padding:7px 8px 5px 0; border-bottom:1px solid var(--line); }
    .field:nth-child(even) { padding-left:10px; border-left:1px solid var(--line); }
    .label { display:block; color:var(--gray); font-size:6.6pt; font-weight:700; text-transform:uppercase; margin-bottom:2px; }
    .value { font-family:"Courier New",monospace; font-size:8pt; font-weight:700; }
    .full { grid-column:1 / -1; border-left:0 !important; padding-left:0 !important; }
    .callout { margin-top:.18in; background:repeating-linear-gradient(-45deg,var(--wash),var(--wash) 3px,var(--paper) 3px,var(--paper) 7px); border:1px solid var(--cobalt2); padding:.15in .18in; }
    .callout p { margin:0; }
    table { width:100%; border-collapse:collapse; table-layout:fixed; }
    th { background:transparent; color:var(--cobalt); border-top:3px double var(--cobalt); border-bottom:1px solid var(--cobalt); padding:7px 6px; font-family:"Courier New",monospace; font-size:6.5pt; text-align:left; text-transform:uppercase; }
    td { border-bottom:1px dotted var(--line); padding:6px; font-size:7.1pt; line-height:1.22; vertical-align:top; }
    tbody tr:nth-child(even) { background:transparent; }
    .seq { width:.3in; text-align:center; }
    .test { width:2.02in; }
    .method { width:1.02in; }
    .criteria { width:1.45in; }
    .result { width:1.1in; }
    .pass { color:var(--cobalt); font-family:"Courier New",monospace; font-weight:800; }
    .table-note { margin-top:9px; font-size:7pt; color:var(--gray); }
    .conclusion { background:transparent; color:var(--ink); padding:.2in .22in; border:3px double var(--cobalt); margin-bottom:.24in; display:grid; grid-template-columns:1.35in 1fr; gap:.2in; align-items:center; }
    .conclusion .word { font-family:"Courier New",monospace; font-size:19pt; font-weight:900; color:var(--red); }
    .conclusion p { margin:0; font-size:9pt; }
    .two-col { display:grid; grid-template-columns:1fr 1fr; gap:.3in; }
    .timeline { border-left:1px dashed var(--cobalt2); margin-left:5px; }
    .timeline-item { position:relative; padding:0 0 12px 18px; font-size:8pt; }
    .timeline-item::before { content:""; position:absolute; left:-5px; top:2px; width:7px; height:7px; background:var(--paper); border:1px solid var(--cobalt); }
    .timeline-item b { display:block; color:var(--cobalt); font-family:"Courier New",monospace; }
    .attachment { padding:7px 0; border-bottom:1px solid var(--line); font-size:8pt; }
    .signatures { display:grid; grid-template-columns:repeat(3,1fr); gap:.18in; margin-top:.25in; }
    .signature { min-height:1.18in; border-top:1px solid var(--cobalt); padding-top:8px; }
    .signature b { display:block; color:var(--ink); font-family:Georgia,"Times New Roman",serif; font-size:8.5pt; }
    .signature span { display:block; font-size:6.8pt; line-height:1.35; color:var(--gray); }
    .language { margin-top:.2in; padding:.13in .16in; border:1px dashed var(--red); color:#6f2a31; font-family:"Courier New",monospace; font-size:7.2pt; }
  </style>
</head>
<body>
{% macro chrome(page_number) -%}
  <div class="top-band"></div>
  <div class="header">
    <img class="logo" src="{{ supplier_logo_uri }}" alt="Meridian API Works">
    <div class="header-meta"><b>{{ document.title }}</b>{{ document.certificate_id }} · Versión {{ document.version }} · {{ document.classification }}</div>
  </div>
  <div class="footer"><span class="notice">{{ document.page_notice }}</span><span>Página {{ page_number }} de 3 · {{ document.certificate_id }}</span></div>
{%- endmacro %}

<section class="page">
  {{ chrome(1) }}
  <main class="content">
    <div class="hero">
      <div><div class="eyebrow">Control de calidad · Principio activo</div><h1>{{ document.title }}</h1></div>
      <div class="status"><span>Estado del lote</span><b>{{ disposition.status }}</b></div>
    </div>
    <div class="identity-grid">
      <section class="panel"><h3>Laboratorio emisor</h3><p><b>{{ issuer.legal_name }}</b><br>{{ issuer.site_name }}<br>{% for line in issuer.address %}{{ line }}{% if not loop.last %}<br>{% endif %}{% endfor %}</p><p class="small"><b>Laboratorio:</b> {{ issuer.laboratory_id }}</p></section>
      <section class="panel"><h3>Cliente</h3><p><b>{{ customer.name }}</b><br>Cuenta {{ customer.account }}<br>Orden de compra {{ customer.purchase_order }}</p><p><b>Proveedor comercial:</b><br>{{ issuer.commercial_supplier }}<br>{{ issuer.commercial_address }}</p></section>
    </div>
    <h2 style="margin-top:.25in">Identificación del material y del lote</h2>
    <div class="field-grid">
      <div class="field"><span class="label">Número de certificado</span><span class="value">{{ document.certificate_id }}</span></div>
      <div class="field"><span class="label">Número de lote</span><span class="value">{{ references.lot }}</span></div>
      <div class="field"><span class="label">Material</span><span class="value">{{ material.name }}</span></div>
      <div class="field"><span class="label">Descripción</span><span class="value">{{ material.description }}</span></div>
      <div class="field"><span class="label">Cantidad liberada</span><span class="value">{{ material.batch_size_kg | number_es }} kg</span></div>
      <div class="field"><span class="label">Especificación</span><span class="value">{{ references.specification }}</span></div>
      <div class="field"><span class="label">Inicio / fin de fabricación</span><span class="value">{{ dates.manufacturing_start | date_es }} / {{ dates.manufacturing_end | date_es }}</span></div>
      <div class="field"><span class="label">Muestreo / emisión</span><span class="value">{{ dates.sampling | date_es }} / {{ dates.issued | date_es }}</span></div>
      <div class="field"><span class="label">Fecha de reanálisis</span><span class="value">{{ dates.retest | date_es }}</span></div>
      <div class="field"><span class="label">Registro de fabricación</span><span class="value">{{ references.manufacturing_record }}</span></div>
      <div class="field full"><span class="label">Sistema de envase</span><span class="value">{{ material.packaging }}</span></div>
    </div>
    <div class="callout"><h3>Trazabilidad comercial</h3><p>Este certificado corresponde a la línea {{ references.invoice_line }} de la factura {{ references.invoice }} y a la hoja de rendimiento {{ references.yield_worksheet }}.</p></div>
  </main>
</section>

<section class="page">
  {{ chrome(2) }}
  <main class="content">
    <div class="eyebrow">Resultados del control</div><h2>Ensayos, criterios de aceptación y resultados</h2>
    <table>
      <thead><tr><th class="seq">N.º</th><th class="test">Ensayo</th><th class="method">Método</th><th class="criteria">Criterio de aceptación</th><th class="result">Resultado</th><th>Dictamen</th></tr></thead>
      <tbody>{% for item in tests %}<tr><td class="seq">{{ item.sequence }}</td><td>{{ item.test }}</td><td>{{ item.method }}</td><td>{{ item.acceptance }}</td><td><b>{{ item.result }}</b></td><td class="pass">{{ item.status }}</td></tr>{% endfor %}</tbody>
    </table>
    <p class="table-note">Los símbolos ≤ y &lt; indican, respectivamente, el límite máximo de aceptación y un resultado inferior al límite de cuantificación declarado. UFC/g: unidades formadoras de colonias por gramo.</p>
    <div class="callout"><h3>Base de evaluación</h3><p>Resultados evaluados frente a la especificación vigente {{ references.specification }}. Registros primarios conservados en {{ references.analytical_record }}. No se realizaron redondeos adicionales para determinar la conformidad.</p></div>
  </main>
</section>

<section class="page">
  {{ chrome(3) }}
  <main class="content">
    <div class="eyebrow">Dictamen y autorización</div><h2>Conclusión del laboratorio</h2>
    <section class="conclusion"><div class="word">{{ disposition.status }}</div><p>{{ disposition.conclusion }}</p></section>
    <div class="two-col">
      <section><h3>Información de la muestra</h3><div class="field-grid"><div class="field"><span class="label">Identificador</span><span class="value">{{ sample.sample_id }}</span></div><div class="field"><span class="label">Cantidad</span><span class="value">{{ sample.quantity }}</span></div><div class="field"><span class="label">Muestreado por</span><span class="value">{{ sample.sampled_by }}</span></div><div class="field"><span class="label">Lugar</span><span class="value">{{ sample.sampling_location }}</span></div><div class="field full"><span class="label">Condición a la recepción</span><span class="value">{{ sample.condition_on_receipt }}</span></div></div><h3 style="margin-top:.2in">Almacenamiento</h3><p>{{ material.storage }}</p></section>
      <section><h3>Cronología controlada</h3><div class="timeline"><div class="timeline-item"><b>{{ dates.manufacturing_start | date_es }}</b>Inicio de fabricación</div><div class="timeline-item"><b>{{ dates.manufacturing_end | date_es }}</b>Fin de fabricación y muestreo</div><div class="timeline-item"><b>{{ dates.analysis_start | date_es }}</b>Inicio de análisis</div><div class="timeline-item"><b>{{ dates.analysis_end | date_es }}</b>Fin de análisis</div><div class="timeline-item"><b>{{ dates.issued | date_es }}</b>Revisión, aprobación y emisión</div></div><h3>Documentos asociados</h3>{% for item in attachments %}<div class="attachment">{{ loop.index }}. {{ item }}</div>{% endfor %}</section>
    </div>
    <div class="callout"><h3>Observaciones</h3><p>{{ disposition.comments }}</p></div>
    <div class="signatures">
      <div class="signature"><b>{{ authorization.analyst.name }}</b><span>{{ authorization.analyst.role }}</span><span>Revisado: {{ authorization.analyst.reviewed_on | date_es }}</span></div>
      <div class="signature"><b>{{ authorization.reviewer.name }}</b><span>{{ authorization.reviewer.role }}</span><span>Revisado: {{ authorization.reviewer.reviewed_on | date_es }}</span></div>
      <div class="signature"><b>{{ authorization.approver.name }}</b><span>{{ authorization.approver.role }}</span><span>Aprobado: {{ authorization.approver.approved_on | date_es }}</span></div>
    </div>
    <div class="language">{{ disposition.language_statement }}</div>
  </main>
</section>
</body>
</html>