<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>{{ metadata.document_id }} — {{ metadata.title }}</title>
  <style>
    @page { size: Letter landscape; margin: 0; }
    * { box-sizing: border-box; }
    :root {
      --forest: #123c36;
      --forest-2: #1f594f;
      --ink: #16242b;
      --coral: #ef6f61;
      --aqua: #cfe9e4;
      --mist: #f2f6f4;
      --gold: #d7a53d;
      --white: #ffffff;
      --line: #b8cbc6;
    }
    html, body { margin: 0; padding: 0; color: var(--ink); font-family: "Avenir Next", "Helvetica Neue", sans-serif; }
    body { background: #d9dfdd; }
    .page {
      position: relative;
      width: 11in;
      height: 8.5in;
      overflow: hidden;
      background: var(--white);
      break-after: page;
      page-break-after: always;
    }
    .page:last-child { break-after: auto; page-break-after: auto; }
    h1, h2, h3, p { margin-top: 0; }
    h1 { font-size: 52pt; line-height: .92; letter-spacing: 0; }
    h2 { font-size: 24pt; line-height: 1.05; letter-spacing: 0; color: var(--forest); }
    h3 { font-size: 11pt; line-height: 1.15; letter-spacing: 0; text-transform: uppercase; color: var(--forest); }
    p, li { font-size: 9.4pt; line-height: 1.38; }
    .small { font-size: 7.6pt; line-height: 1.35; }
    .eyebrow { font-size: 8pt; font-weight: 700; text-transform: uppercase; letter-spacing: 0; }
    .brand-logo { display: block; width: 1.35in; height: .34in; object-fit: contain; }
    .header { position: absolute; top: .28in; left: .48in; right: .48in; height: .42in; display: flex; align-items: center; justify-content: space-between; z-index: 5; }
    .header .doc { color: var(--forest-2); font-size: 7.4pt; font-weight: 600; }
    .nav { position: absolute; top: .82in; left: .48in; right: .48in; display: grid; grid-template-columns: repeat(5, 1fr); gap: 8px; z-index: 5; }
    .nav-item { border-top: 2px solid var(--aqua); padding-top: 5px; font-size: 7pt; color: #5f827a; }
    .nav-item.active { border-color: var(--coral); color: var(--forest); font-weight: 800; }
    .footer { position: absolute; left: .48in; right: .48in; bottom: .25in; display: flex; justify-content: space-between; align-items: center; color: #54726c; font-size: 7pt; }
    .footer strong { color: var(--forest); }
    .content { position: absolute; top: 1.35in; left: .48in; right: .48in; bottom: .52in; }
    .cover { color: white; background: var(--forest); }
    .cover-photo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
    .cover-overlay { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(10,49,43,.92) 0%, rgba(10,49,43,.69) 42%, rgba(10,49,43,.08) 72%); }
    .cover-frame { position: absolute; inset: .25in; border: 1.5px solid rgba(255,255,255,.8); }
    .cover-copy { position: absolute; left: .7in; top: 1.25in; width: 5.2in; }
    .cover-copy h1 { margin-bottom: .22in; max-width: 4.4in; }
    .cover-copy .subtitle { width: 4.5in; font-size: 15pt; line-height: 1.25; font-weight: 500; }
    .cover-meta { position: absolute; left: .7in; bottom: .65in; display: grid; grid-template-columns: 1.5in 1.5in 1.8in; gap: .22in; }
    .cover-meta div { border-top: 1px solid rgba(255,255,255,.7); padding-top: 6px; font-size: 7.5pt; }
    .cover-brand { position: absolute; right: .65in; top: .55in; width: 2.25in; height: .55in; object-fit: contain; }
    .split-40 { display: grid; grid-template-columns: 4.05in 1fr; gap: .45in; height: 100%; }
    .split-50 { display: grid; grid-template-columns: 1fr 1fr; gap: .45in; height: 100%; }
    .photo-panel { height: 100%; overflow: hidden; position: relative; background: var(--aqua); }
    .photo-panel img { width: 100%; height: 100%; object-fit: cover; }
    .photo-caption { position: absolute; left: 12px; bottom: 12px; padding: 6px 9px; background: rgba(18,60,54,.9); color: white; font-size: 7pt; }
    .statement { font-family: Georgia, serif; font-size: 17pt; line-height: 1.34; color: var(--forest); }
    .meta-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0; border-top: 1px solid var(--line); }
    .meta-cell { padding: 9px 12px 9px 0; border-bottom: 1px solid var(--line); }
    .meta-cell:nth-child(even) { padding-left: 12px; border-left: 1px solid var(--line); }
    .meta-cell b { display: block; color: var(--forest); font-size: 7pt; text-transform: uppercase; margin-bottom: 2px; }
    .toc { display: grid; grid-template-columns: 1.55in 1fr; gap: .18in; border-top: 1px solid var(--line); padding: 11px 0; }
    .toc-num { font-size: 26pt; color: var(--coral); font-weight: 700; }
    .toc h3 { margin-bottom: 4px; }
    .at-glance { background: var(--forest); color: white; padding: .24in .3in; display: flex; flex-direction: column; justify-content: space-between; }
    .at-glance h2 { color: white; font-size: 21pt; margin-bottom: 4px; }
    .metric { border-top: 1px solid rgba(255,255,255,.35); padding-top: 6px; }
    .metric b { display: block; font-size: 18pt; line-height: 1; color: var(--gold); }
    .metric span { font-size: 8.5pt; }
    .scope-list { padding-left: 18px; margin: 0; }
    .scope-list li { margin-bottom: 9px; }
    .section-number { font-size: 104pt; line-height: .8; font-weight: 800; color: var(--aqua); }
    .section-opener { display: grid; grid-template-columns: 5.2in 1fr; gap: .35in; height: 100%; align-items: center; }
    .section-photo { height: 5.2in; overflow: hidden; }
    .section-photo img { width: 100%; height: 100%; object-fit: cover; }
    .section-copy { border-left: 2px solid var(--coral); padding-left: .25in; }
    .principle-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: .2in; }
    .principle { min-height: 2.25in; padding: .2in; background: var(--mist); border-top: 5px solid var(--forest); }
    .principle:nth-child(2), .principle:nth-child(5) { border-color: var(--coral); }
    .principle:nth-child(3), .principle:nth-child(6) { border-color: var(--gold); }
    .principle .num { font-size: 23pt; font-weight: 800; color: var(--line); }
    .principle h3 { font-size: 10pt; margin: 5px 0 9px; }
    .role-table, .policy-table { width: 100%; border-collapse: collapse; }
    .role-table th, .policy-table th { background: var(--forest); color: white; font-size: 7.6pt; text-align: left; padding: 8px; }
    .role-table td, .policy-table td { border-bottom: 1px solid var(--line); padding: 8px; font-size: 8.2pt; line-height: 1.3; vertical-align: top; }
    .role-table td:first-child { width: 1.7in; font-weight: 700; color: var(--forest); }
    .callout { background: var(--aqua); padding: .22in; border-left: 5px solid var(--coral); }
    .method-grid { display: grid; grid-template-columns: 1fr 1fr; gap: .18in; }
    .method { border: 1px solid var(--line); padding: .2in; min-height: 1.45in; }
    .method h3 { color: var(--forest); margin-bottom: 7px; }
    .thresholds { margin-top: .15in; }
    .threshold-row { display: grid; grid-template-columns: 1.25in 2.65in 1fr; border-top: 1px solid var(--line); padding: 7px 0; gap: .15in; font-size: 7.8pt; }
    .threshold-row b { color: var(--forest); }
    .tier-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: .18in; }
    .tier { padding: .22in; min-height: 2.2in; color: white; background: var(--forest); }
    .tier:nth-child(2) { background: var(--forest-2); }
    .tier:nth-child(3) { background: #426f66; }
    .tier .label { color: var(--gold); font-weight: 800; font-size: 21pt; }
    .score-layout { display: grid; grid-template-columns: 4.2in 1fr; gap: .4in; }
    .score-row { display: grid; grid-template-columns: 2.25in 1fr .6in; align-items: center; gap: 8px; margin-bottom: 11px; }
    .score-name { font-size: 8.5pt; }
    .bar { height: 10px; background: var(--mist); }
    .bar span { display: block; height: 100%; background: var(--forest); }
    .score-row:nth-child(2) .bar span, .score-row:nth-child(5) .bar span { background: var(--coral); }
    .score-row:nth-child(3) .bar span, .score-row:nth-child(6) .bar span { background: var(--gold); }
    .gate { color: var(--coral); font-size: 7pt; font-weight: 800; }
    .rules { margin: 0; padding-left: 17px; }
    .rules li { margin-bottom: 10px; }
    .lifecycle { display: grid; grid-template-columns: repeat(5, 1fr); gap: 5px; }
    .stage { min-height: 2.2in; background: var(--mist); padding: .18in; position: relative; border-top: 5px solid var(--forest); }
    .stage::after { content: ""; position: absolute; right: -8px; top: .2in; border-left: 8px solid var(--coral); border-top: 8px solid transparent; border-bottom: 8px solid transparent; z-index: 2; }
    .stage:last-child::after { display: none; }
    .stage .step { font-size: 23pt; color: var(--coral); font-weight: 800; }
    .monitor-grid { display: grid; grid-template-columns: 1fr 1fr; gap: .25in; margin-top: .3in; }
    .compact-list { padding-left: 16px; margin: 0; }
    .compact-list li { margin-bottom: 7px; font-size: 8.3pt; }
    .ethics-layout { display: grid; grid-template-columns: 1.1fr .9fr; gap: .45in; }
    .ethics-rule { display: grid; grid-template-columns: .38in 1fr; gap: 8px; border-top: 1px solid var(--line); padding: 9px 0; }
    .ethics-rule span { width: 25px; height: 25px; display: grid; place-items: center; background: var(--coral); color: white; font-weight: 800; }
    .supply-layout { display: grid; grid-template-columns: 4.5in 1fr; gap: .4in; height: 100%; }
    .supply-photo { position: relative; height: 100%; overflow: hidden; }
    .supply-photo img { width: 100%; height: 100%; object-fit: cover; }
    .supply-topics { display: grid; grid-template-columns: 1fr 1fr; gap: .15in; }
    .supply-topic { padding: .16in; background: var(--mist); border-top: 4px solid var(--forest); }
    .supply-topic:nth-child(even) { border-color: var(--coral); }
    .annex-grid { display: grid; grid-template-columns: 1fr 1fr; gap: .38in; }
    .commitment { display: grid; grid-template-columns: .35in 1fr; gap: 9px; padding: 7px 0; border-bottom: 1px solid var(--line); }
    .commitment b { color: var(--coral); font-size: 13pt; }
    .field { border-bottom: 1px solid var(--line); padding: 7px 0; font-size: 8.3pt; }
    .approval-band { position: absolute; left: 0; right: 0; bottom: 0; height: 1.55in; background: var(--forest); color: white; padding: .27in .48in; display: grid; grid-template-columns: 1.2fr 1fr 1fr 1fr; gap: .25in; }
    .signature { border-top: 1px solid rgba(255,255,255,.6); padding-top: 6px; font-size: 7.2pt; }
    .approval-band h2 { color: white; font-size: 18pt; }
  </style>
</head>
<body>
{% macro chrome(page_no, active) -%}
  <div class="header">
    <img class="brand-logo" src="../../../caldova_logo.png" alt="Caldova">
    <div class="doc">{{ metadata.document_id }} · Version {{ metadata.version }} · {{ metadata.classification }}</div>
  </div>
  <div class="nav">
    {% for item in navigation %}<div class="nav-item{% if loop.index == active %} active{% endif %}">{{ loop.index }}&nbsp;&nbsp;{{ item }}</div>{% endfor %}
  </div>
  <div class="footer"><span><strong>{{ page_no }}</strong>&nbsp;&nbsp;|&nbsp;&nbsp;Caldova Pharmaceuticals purchasing policy</span><span>Fictional demonstration document</span></div>
{%- endmacro %}

<section class="page cover">
  <img class="cover-photo" src="../assets/caldova-manufacturing-cover.png" alt="Modern pharmaceutical manufacturing facility">
  <div class="cover-overlay"></div><div class="cover-frame"></div>
  <img class="cover-brand" src="../../../caldova_logo.png" alt="Caldova">
  <div class="cover-copy">
    <div class="eyebrow">Global policy · {{ metadata.document_id }}</div>
    <h1>{{ metadata.title }}</h1>
    <p class="subtitle">{{ metadata.subtitle }}</p>
  </div>
  <div class="cover-meta">
    <div><b>Version</b><br>{{ metadata.version }}</div>
    <div><b>Effective</b><br>{{ metadata.effective_from }}</div>
    <div><b>Classification</b><br>{{ metadata.classification }}</div>
  </div>
</section>

<section class="page">
  {{ chrome(2, 1) }}
  <div class="content split-50">
    <div>
      <div class="eyebrow" style="color:var(--coral)">A message from Procurement</div>
      <h2>What we buy shapes what we can deliver.</h2>
      <p class="statement">“{{ leadership_statement }}”</p>
      <div class="callout"><b>Policy promise</b><br><span class="small">Caldova will make purchasing decisions that are evidence-based, explainable, properly authorized, and proportionate to risk.</span></div>
    </div>
    <div>
      <h3>Document control</h3>
      <div class="meta-grid">
        <div class="meta-cell"><b>Document ID</b>{{ metadata.document_id }}</div>
        <div class="meta-cell"><b>Version</b>{{ metadata.version }}</div>
        <div class="meta-cell"><b>Approved</b>{{ metadata.approved_on }}</div>
        <div class="meta-cell"><b>Effective</b>{{ metadata.effective_from }}</div>
        <div class="meta-cell"><b>Next review</b>{{ metadata.next_review }}</div>
        <div class="meta-cell"><b>Classification</b>{{ metadata.classification }}</div>
        <div class="meta-cell"><b>Policy owner</b>{{ metadata.policy_owner }}</div>
        <div class="meta-cell"><b>Administrator</b>{{ metadata.policy_administrator }}</div>
      </div>
      <h3 style="margin-top:.25in">Approved by</h3>
      {% for approver in metadata.approvers %}<p style="margin-bottom:6px">{{ approver }}</p>{% endfor %}
    </div>
  </div>
</section>

<section class="page">
  {{ chrome(3, 1) }}
  <div class="content split-50">
    <div>
      <div class="eyebrow" style="color:var(--coral)">Contents</div>
      <h2>How to use this policy</h2>
      {% set page_refs = [4,5,7,9,14] %}
      {% for item in navigation %}
      <div class="toc"><div class="toc-num">0{{ loop.index }}</div><div><h3>{{ item }}</h3><p class="small">Starts on page {{ page_refs[loop.index0] }}</p></div></div>
      {% endfor %}
    </div>
    <div class="at-glance">
      <div><div class="eyebrow" style="color:var(--gold)">Policy at a glance</div><h2>Four controls apply to every purchase.</h2></div>
      <div class="metric"><b>01</b><span>Define the business need and accountable owner.</span></div>
      <div class="metric"><b>02</b><span>Use proportionate competition and due diligence.</span></div>
      <div class="metric"><b>03</b><span>Separate request, selection, approval, and receipt.</span></div>
      <div class="metric"><b>04</b><span>Document the decision before commitment.</span></div>
    </div>
  </div>
</section>

<section class="page">
  {{ chrome(4, 1) }}
  <div class="content split-50">
    <div>
      <div class="section-number">1</div>
      <h2>Purpose and scope</h2>
      <p>{{ purpose }}</p>
      <div class="callout small"><b>Global minimum.</b> Local law, regulation, quality procedures, delegated authority, and contractual controls may be stricter. The stricter requirement applies.</div>
    </div>
    <div>
      <h3>This policy applies to</h3>
      <ul class="scope-list">{% for item in scope_includes %}<li>{{ item }}</li>{% endfor %}</ul>
      <h3 style="margin-top:.25in">Managed separately</h3>
      <ul class="scope-list">{% for item in scope_exclusions %}<li>{{ item }}</li>{% endfor %}</ul>
      <h3 style="margin-top:.25in">No commitment before approval</h3>
      <p>Only an authorized purchase order or signed contract may commit Caldova. Supplier work must not begin on the basis of an email, meeting, requisition, or verbal instruction.</p>
    </div>
  </div>
</section>

<section class="page">
  {{ chrome(5, 2) }}
  <div class="content section-opener">
    <div class="section-photo"><img src="../assets/resilient-supply-logistics.png" alt="Pharmaceutical distribution quality checkpoint"></div>
    <div class="section-copy"><div class="section-number">2</div><h2>Purchasing principles</h2><p>Six principles guide every decision, from a routine catalog order to a strategic contract-manufacturing agreement.</p></div>
  </div>
</section>

<section class="page">
  {{ chrome(6, 2) }}
  <div class="content">
    <div class="eyebrow" style="color:var(--coral)">Six decision principles</div><h2>Value begins with trust.</h2>
    <div class="principle-grid">
      {% for principle in principles %}<div class="principle"><div class="num">{{ principle.number }}</div><h3>{{ principle.title }}</h3><p class="small">{{ principle.body }}</p></div>{% endfor %}
    </div>
  </div>
</section>

<section class="page">
  {{ chrome(7, 3) }}
  <div class="content">
    <div class="eyebrow" style="color:var(--coral)">Decision rights</div><h2>Different hands define, select, approve, and receive.</h2>
    <table class="role-table"><thead><tr><th>Role</th><th>Primary accountability</th></tr></thead><tbody>{% for item in roles %}<tr><td>{{ item.role }}</td><td>{{ item.accountability }}</td></tr>{% endfor %}</tbody></table>
    <div class="callout" style="margin-top:.2in"><b>Segregation of duties</b><br><span class="small">No individual may control the requirement, supplier selection, approval, receipt, and payment for the same transaction. Where staffing makes full separation impractical, Finance must approve and record a compensating review.</span></div>
  </div>
</section>

<section class="page">
  {{ chrome(8, 3) }}
  <div class="content split-50">
    <div>
      <div class="eyebrow" style="color:var(--coral)">Sourcing routes</div><h2>Competition is the default.</h2>
      <div class="method-grid">{% for item in sourcing_methods %}<div class="method"><h3>{{ item.name }}</h3><p class="small">{{ item.use }}</p></div>{% endfor %}</div>
      <div class="callout small" style="margin-top:.18in"><b>Always apply the higher control.</b> Critical GxP suppliers require Quality qualification regardless of spend. Contract, privacy, cybersecurity, and regulatory controls also apply independently of value.</div>
    </div>
    <div>
      <h3>Minimum competition and approval</h3>
      <div class="thresholds">{% for item in approval_thresholds %}<div class="threshold-row"><b>{{ item.display }}</b><span>{{ item.competition }}</span><span>{{ item.approval }}</span></div>{% endfor %}</div>
      <h3 style="margin-top:.22in">Exceptions</h3>
      <p>Any departure from minimum competition or standard control requires a written exception before commitment. The exception must identify risk, compensating controls, approvers, and an expiry date. Poor planning, supplier preference, or work already started is not a valid justification.</p>
    </div>
  </div>
</section>

<section class="page">
  {{ chrome(9, 4) }}
  <div class="content section-opener">
    <div class="section-photo"><img src="../assets/supplier-qualification-lab.png" alt="Quality-control laboratory supplier qualification"></div>
    <div class="section-copy"><div class="section-number">4</div><h2>Supplier lifecycle</h2><p>Qualification is proportionate to what can go wrong, not simply to what Caldova spends.</p></div>
  </div>
</section>

<section class="page">
  {{ chrome(10, 4) }}
  <div class="content">
    <div class="eyebrow" style="color:var(--coral)">Risk classification</div><h2>Three tiers. One evidence standard.</h2>
    <div class="tier-grid">{% for item in qualification_tiers %}<div class="tier"><div class="label">{{ item.tier }}</div><h3 style="color:white;margin-top:8px">Typical scope</h3><p class="small">{{ item.examples }}</p><h3 style="color:white">Minimum controls</h3><p class="small">{{ item.controls }}</p></div>{% endfor %}</div>
    <div class="callout" style="margin-top:.25in"><b>Risk can move.</b><br><span class="small">A supplier's tier must be reassessed when scope, site, ownership, subcontracting, technology, regulatory status, data access, geography, performance, or dependency materially changes.</span></div>
  </div>
</section>

<section class="page">
  {{ chrome(11, 4) }}
  <div class="content score-layout">
    <div>
      <div class="eyebrow" style="color:var(--coral)">Evaluation model</div><h2>Compare evidence, not impressions.</h2>
      {% for item in scorecard %}<div class="score-row"><div class="score-name">{{ item.criterion }}{% if item.gate %} <span class="gate">GATE</span>{% endif %}</div><div class="bar"><span style="width:{{ item.weight * 3 }}%"></span></div><b>{{ item.weight }}%</b></div>{% endfor %}
      <p class="small">Category teams may refine subcriteria before release, but published weights may not be changed after offers are opened without restarting or formally amending the process.</p>
    </div>
    <div>
      <h3>Qualification rules</h3><ol class="rules">{% for item in qualification_rules %}<li>{{ item }}</li>{% endfor %}</ol>
      <div class="callout small"><b>Decision record.</b> The sourcing file must preserve requirements, invited suppliers, offers, clarifications, evaluation evidence, conflicts, approvals, negotiation outcomes, and the final recommendation.</div>
    </div>
  </div>
</section>

<section class="page">
  {{ chrome(12, 4) }}
  <div class="content">
    <div class="eyebrow" style="color:var(--coral)">End-to-end control</div><h2>Selection is only the beginning.</h2>
    <div class="lifecycle">{% for item in lifecycle %}<div class="stage"><div class="step">0{{ loop.index }}</div><h3>{{ item.stage }}</h3><p class="small">{{ item.detail }}</p></div>{% endfor %}</div>
    <div class="monitor-grid">
      <div><h3>Monitoring cadence</h3><ul class="compact-list">{% for item in monitoring %}<li>{{ item }}</li>{% endfor %}</ul></div>
      <div><h3>Corrective action and escalation</h3><ol class="compact-list">{% for item in capa_steps %}<li>{{ item }}</li>{% endfor %}</ol></div>
    </div>
  </div>
</section>

<section class="page">
  {{ chrome(13, 4) }}
  <div class="content split-50">
    <div>
      <div class="eyebrow" style="color:var(--coral)">Integrity and responsible supply</div><h2>How we buy matters.</h2>
      {% for item in ethics_rules %}<div class="ethics-rule"><span>{{ loop.index }}</span><p class="small">{{ item }}</p></div>{% endfor %}
    </div>
    <div>
      <h3>Supplier expectations</h3>
      <div class="supply-topics">{% for item in responsible_supply %}<div class="supply-topic"><h3>{{ item.topic }}</h3><p class="small">{{ item.commitment }}</p></div>{% endfor %}</div>
      <div class="photo-panel" style="height:2.4in;margin-top:.18in"><img src="../assets/resilient-supply-logistics.png" alt="Responsible pharmaceutical logistics"><div class="photo-caption">Continuity is built before disruption.</div></div>
    </div>
  </div>
</section>

<section class="page">
  {{ chrome(14, 5) }}
  <div class="content annex-grid" style="bottom:1.8in">
    <div>
      <div class="eyebrow" style="color:var(--coral)">Annex A</div><h2>Buyer commitments</h2>
      {% for item in buyer_commitments %}<div class="commitment"><b>{{ loop.index }}</b><span class="small">{{ item }}</span></div>{% endfor %}
    </div>
    <div>
      <div class="eyebrow" style="color:var(--coral)">Annex B</div><h2>Exception record</h2>
      <p class="small">At minimum, every exception record must contain:</p>
      {% for item in exception_fields %}<div class="field"><b>{{ loop.index }}.</b>&nbsp;&nbsp;{{ item }}</div>{% endfor %}
    </div>
  </div>
  <div class="approval-band">
    <div><div class="eyebrow" style="color:var(--gold)">Approval</div><h2>Effective {{ metadata.effective_from }}</h2></div>
    {% for approver in metadata.approvers %}<div class="signature">Approved electronically<br><b>{{ approver }}</b><br>{{ metadata.approved_on }}</div>{% endfor %}
  </div>
</section>
</body>
</html>