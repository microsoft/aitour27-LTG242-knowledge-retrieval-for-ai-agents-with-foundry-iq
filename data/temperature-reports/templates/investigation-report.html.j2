<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>{{ event.references.investigation }} - temperature excursion investigation</title>
  <style>
    @page { margin: 0; size: Letter; }
    * { box-sizing: border-box; }
    body { color: #24343a; font-family: "Helvetica Neue", Helvetica, sans-serif; margin: 0; }
    .page { height: 11in; padding: .42in .5in .38in; position: relative; width: 8.5in; }
    .page + .page { break-before: page; }
    header { align-items: center; border-bottom: 5px solid #23566b; display: flex; justify-content: space-between; padding-bottom: 11px; }
    .supplier-logo { height: 50px; max-width: 280px; object-fit: contain; object-position: left center; }
    .title { text-align: right; }
    .title h1 { color: #23566b; font-size: 18px; margin: 0 0 4px; }
    .title p { font-size: 9px; margin: 0; }
    .status { background: #dcefe7; border: 2px solid #2f7659; color: #205b43; font-size: 11px; font-weight: 800; margin-top: 12px; padding: 8px 12px; text-align: center; text-transform: uppercase; }
    h2 { background: #23566b; color: white; font-size: 10px; letter-spacing: 0; margin: 13px 0 0; padding: 6px 9px; text-transform: uppercase; }
    h3 { color: #23566b; font-size: 10px; margin: 11px 0 5px; }
    .grid { border-left: 1px solid #b9c8ce; border-top: 1px solid #b9c8ce; display: grid; }
    .cols-4 { grid-template-columns: repeat(4, 1fr); }
    .cols-3 { grid-template-columns: repeat(3, 1fr); }
    .cols-2 { grid-template-columns: repeat(2, 1fr); }
    .field { border-bottom: 1px solid #b9c8ce; border-right: 1px solid #b9c8ce; min-height: 43px; padding: 7px 8px; }
    .span-2 { grid-column: span 2; }
    .span-3 { grid-column: span 3; }
    .span-4 { grid-column: span 4; }
    .label { color: #65767d; font-size: 7px; font-weight: 800; margin-bottom: 4px; text-transform: uppercase; }
    .value { font-size: 9px; font-weight: 600; line-height: 1.35; }
    .route { align-items: center; background: #eef7fa; display: grid; grid-template-columns: 1fr auto 1fr; margin-top: 12px; padding: 9px 12px; }
    .route strong { color: #23566b; display: block; font-size: 11px; }
    .route span { color: #64777e; font-size: 8px; }
    .arrow { color: #57a4bd; font-size: 18px; padding: 0 18px; }
    .check-list { border: 1px solid #b9c8ce; padding: 5px 10px; }
    .check { font-size: 9px; line-height: 1.55; }
    .box { border: 1px solid #b9c8ce; font-size: 9px; line-height: 1.5; padding: 9px 10px; }
    .callout { background: #fff4f1; border-left: 4px solid #9d342d; font-size: 9px; line-height: 1.45; padding: 9px 11px; }
    table { border-collapse: collapse; font-size: 8px; margin-top: 0; width: 100%; }
    th { background: #e7f1f4; color: #23566b; font-size: 7px; padding: 6px; text-align: left; text-transform: uppercase; }
    td { border-bottom: 1px solid #c8d3d7; padding: 7px 6px; vertical-align: top; }
    .decision { border: 2px solid #2f7659; margin-top: 12px; padding: 11px 12px; }
    .decision strong { color: #205b43; display: block; font-size: 13px; margin-bottom: 4px; }
    .decision p { font-size: 9px; line-height: 1.5; margin: 0; }
    .signatures { display: grid; gap: 16px; grid-template-columns: repeat(3, 1fr); margin-top: 20px; }
    .signature { border-top: 1px solid #53666e; padding-top: 5px; }
    .signature strong { display: block; font-size: 8px; }
    .signature span { color: #65767d; font-size: 7px; }
    .attachments { font-size: 8px; margin: 7px 0 0; padding-left: 18px; }
    .attachments li { margin: 4px 0; }
    footer { bottom: .22in; color: #718087; display: flex; font-size: 7px; justify-content: space-between; left: .5in; position: absolute; right: .5in; }
  </style>
</head>
<body>
<section class="page">
  <header>
    <img class="supplier-logo" src="{{ supplier_logo_uri }}" alt="{{ event.supplier.name }}">
    <div class="title"><h1>Temperature excursion investigation</h1><p>Quality event {{ event.references.investigation }}</p></div>
  </header>
  <div class="status">Final report - product released</div>

  <section class="route">
    <div><strong>{{ event.route.origin }}</strong><span>Origin</span></div>
    <div class="arrow">&#8594;</div>
    <div style="text-align:right"><strong>{{ event.route.destination }}</strong><span>Destination</span></div>
  </section>

  <h2>1. Event identification</h2>
  <div class="grid cols-4">
    <div class="field"><div class="label">Investigation</div><div class="value">{{ event.references.investigation }}</div></div>
    <div class="field"><div class="label">Temperature record</div><div class="value">{{ event.references.temperature_log }}</div></div>
    <div class="field"><div class="label">Shipment</div><div class="value">{{ event.references.shipment }}</div></div>
    <div class="field"><div class="label">POD</div><div class="value">{{ event.references.proof_of_delivery }}</div></div>
    <div class="field"><div class="label">Customer</div><div class="value">{{ event.customer.name }}</div></div>
    <div class="field"><div class="label">Lane authorization</div><div class="value">{{ event.references.lane_authorization }}</div></div>
    <div class="field"><div class="label">Waybill</div><div class="value">{{ event.route.carrier_waybill }}</div></div>
    <div class="field"><div class="label">Service</div><div class="value">{{ event.route.service }}</div></div>
  </div>

  <h2>2. Excursion details</h2>
  <div class="grid cols-4">
    <div class="field"><div class="label">Event type</div><div class="value">{{ event.excursion.event_type }}</div></div>
    <div class="field"><div class="label">Started</div><div class="value">{{ event.excursion.started_at|display_time }}</div></div>
    <div class="field"><div class="label">Returned in range</div><div class="value">{{ event.excursion.ended_at|display_time }}</div></div>
    <div class="field"><div class="label">Duration</div><div class="value">{{ event.excursion.duration_minutes|duration }}</div></div>
    <div class="field"><div class="label">Validated range</div><div class="value">{{ '%.1f'|format(event.logger.low_limit_c) }}-{{ '%.1f'|format(event.logger.high_limit_c) }} C</div></div>
    <div class="field"><div class="label">Maximum recorded</div><div class="value">{{ '%.1f'|format(event.excursion.maximum_temperature_c) }} C</div></div>
    <div class="field span-2"><div class="label">Location</div><div class="value">{{ event.excursion.location }}</div></div>
  </div>
  <div class="callout"><strong>Event description:</strong> {{ event.excursion.description }}</div>

  <h2>3. Affected inventory and immediate action</h2>
  <div class="grid cols-3">
    <div class="field"><div class="label">Product</div><div class="value">{{ event.inventory.product_description }}</div></div>
    <div class="field"><div class="label">Lot</div><div class="value">{{ event.inventory.lot_number }}</div></div>
    <div class="field"><div class="label">Quantity affected</div><div class="value">{{ event.inventory.quantity }}</div></div>
    <div class="field"><div class="label">Previous excursions</div><div class="value">{{ event.inventory.previous_excursions }}</div></div>
    <div class="field"><div class="label">Physical quarantine</div><div class="value">Yes - confirmed</div></div>
    <div class="field"><div class="label">Detected</div><div class="value">{{ event.excursion.detected_at|display_time }}</div></div>
  </div>
  <div class="check-list">
    {% for action in event.excursion.immediate_actions %}<div class="check">&#9745; {{ action }}</div>{% endfor %}
  </div>

  <h2>4. Evidence reviewed</h2>
  <table>
    <thead><tr><th>Evidence</th><th>Identifier</th><th>Finding</th></tr></thead>
    <tbody>
      <tr><td>USB logger export</td><td>{{ event.references.temperature_log }}</td><td>One high event; peak {{ '%.1f'|format(event.excursion.maximum_temperature_c) }} C; {{ event.excursion.duration_minutes|duration }} above limit.</td></tr>
      <tr><td>Proof of delivery</td><td>{{ event.references.proof_of_delivery }}</td><td>Shipment received intact; no visible shipper damage recorded.</td></tr>
      <tr><td>Lane authorization</td><td>{{ event.references.lane_authorization }}</td><td>Boston-Frankfurt 2-8 C lane approved for October operation.</td></tr>
    </tbody>
  </table>
  <footer><span>Valence Quality Operations | Confidential quality record</span><span>{{ event.references.investigation }} | Page 1 of 2</span></footer>
</section>

<section class="page">
  <header>
    <img class="supplier-logo" src="{{ supplier_logo_uri }}" alt="{{ event.supplier.name }}">
    <div class="title"><h1>Investigation and disposition</h1><p>{{ event.references.investigation }} | Continued</p></div>
  </header>

  <h2>5. Investigation</h2>
  <h3>Probable cause</h3>
  <div class="box">{{ event.excursion.probable_cause }}</div>
  <h3>Contributing factor</h3>
  <div class="box">{{ event.excursion.contributing_factor }}</div>
  <div class="grid cols-2">
    <div class="field"><div class="label">Cause category</div><div class="value">Ground-handler transfer delay</div></div>
    <div class="field"><div class="label">Packaging condition</div><div class="value">Intact; no opening or physical damage observed</div></div>
  </div>

  <h2>6. Product quality assessment</h2>
  <div class="grid cols-4">
    <div class="field"><div class="label">Assessment requested</div><div class="value">{{ event.assessment.requested_at|display_time }}</div></div>
    <div class="field"><div class="label">Assessment completed</div><div class="value">{{ event.assessment.completed_at|display_time }}</div></div>
    <div class="field"><div class="label">Stability case</div><div class="value">{{ event.assessment.stability_case_number }}</div></div>
    <div class="field"><div class="label">Cumulative exposure</div><div class="value">Reviewed - no prior events</div></div>
    <div class="field span-4"><div class="label">Assessment conclusion</div><div class="value">{{ event.assessment.conclusion }}</div></div>
  </div>

  <h2>7. Corrective and preventive actions</h2>
  <table>
    <thead><tr><th style="width:8%">Item</th><th>Action</th><th style="width:22%">Owner</th><th style="width:16%">Due</th></tr></thead>
    <tbody>
      {% for action in event.excursion.corrective_actions %}<tr><td>CA-{{ loop.index }}</td><td>{{ action }}</td><td>{{ "EU Lane Operations" if loop.index < 3 else "Quality Systems" }}</td><td>{{ "30 Oct 2026" if loop.index < 3 else "15 Nov 2026" }}</td></tr>{% endfor %}
    </tbody>
  </table>

  <h2>8. Final disposition</h2>
  <div class="decision">
    <strong>&#9745; {{ event.assessment.disposition }}</strong>
    <p>{{ event.assessment.conclusion }} Quarantine was removed on {{ event.assessment.released_at|display_time }}. Product may proceed through the authorized distribution channel.</p>
  </div>

  <h2>9. Approvals</h2>
  <div class="signatures">
    <div class="signature"><strong>{{ event.assessment.investigator }}</strong><span>Investigator | Signed 16 Oct 2026</span></div>
    <div class="signature"><strong>{{ event.assessment.quality_reviewer }}</strong><span>Valence quality review | Signed 16 Oct 2026</span></div>
    <div class="signature"><strong>{{ event.assessment.approved_by }}</strong><span>Customer disposition approval | Signed 16 Oct 2026</span></div>
  </div>

  <h2>10. Attached and related records</h2>
  <ul class="attachments">
    <li>Temperature logger report {{ event.references.temperature_log }}</li>
    <li>Proof of delivery {{ event.references.proof_of_delivery }}</li>
    <li>Lane authorization {{ event.references.lane_authorization }}</li>
    <li>Supplier invoice {{ event.references.invoice }}, excursion handling line L003</li>
  </ul>

  <footer><span>Valence Quality Operations | Final report issued 16 Oct 2026</span><span>{{ event.references.investigation }} | Page 2 of 2</span></footer>
</section>
</body>
</html>
