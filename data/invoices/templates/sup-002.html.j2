{% extends "_base.html.j2" %}
{% import "_components.html.j2" as c with context %}
{% block supplier_css %}
  body { font-family: Georgia, serif; }
  .certificate { border:6px double var(--primary); margin:.22in; min-height:10.56in; padding:.28in; }
  .certificate-head { align-items:center; display:grid; grid-template-columns:1fr auto 1fr; text-align:center; }
  .certificate-head .brand { justify-content:center; }
  .certificate-head .heading { text-align:right; }
  .seal { border:1px solid var(--accent); color:var(--primary); font-size:8px; letter-spacing:.12em; padding:7px; text-transform:uppercase; }
  .quality-title { border-bottom:1px solid var(--primary); border-top:1px solid var(--primary); color:var(--primary); font-size:14px; letter-spacing:.14em; margin:14px 0 10px; padding:7px; text-align:center; text-transform:uppercase; }
  .certificate .meta { margin-bottom:12px; }
  .certificate table { margin-top:12px; }
  .certificate .totals { margin-top:10px; }
{% endblock %}
{% block document %}<article class="invoice certificate">
  <header class="certificate-head"><div class="seal">Quality agreement<br>billing record</div>{{ c.brand() }}{{ c.heading() }}</header>
  <div class="quality-title">Sterile fill-finish release statement</div>{{ c.metadata() }}
  <div class="grid-2">{{ c.parties() }}</div>
  <section class="grid-2" style="margin-top:12px">{{ c.terms() }}{{ c.references() }}</section>
  {{ c.line_table('Release record', 'QA classification', 'Lots', 'Quality evidence') }}
  <div style="margin-top:10px">{{ c.totals('Certified amount due') }}</div>{{ c.footer() }}
</article>{% endblock %}
