{% extends "_base.html.j2" %}
{% import "_components.html.j2" as c with context %}
{% block supplier_css %}
  .docket { background:linear-gradient(180deg,var(--tint) 0, var(--tint) 1.35in,#fff 1.35in); }
  .docket-head { align-items:start; display:grid; gap:16px; grid-template-columns:1fr auto; }
  .docket-number { background:var(--primary); color:#fff; padding:10px 14px; text-align:right; }
  .docket-title { color:var(--primary); font-size:16px; font-weight:800; margin:16px 0 8px; text-transform:uppercase; }
  .delivery-grid { display:grid; gap:12px; grid-template-columns:1.4fr .6fr; }
  .docket table { border:1px solid var(--primary); margin-top:14px; }
  .docket th { background:#fff; border-bottom:3px solid var(--primary); color:var(--primary); }
  .docket td { border-bottom:1px dotted var(--primary); }
{% endblock %}
{% block document %}<article class="invoice docket">
  <header class="docket-head">{{ c.brand() }}<div class="docket-number"><div>REGULATED MATERIALS</div><strong>{{ invoice.invoice_id }}</strong></div></header>
  <div class="docket-title">Supply and documentation docket</div><section class="delivery-grid"><div class="stack">{{ c.metadata() }}{{ c.parties() }}</div><div class="stack">{{ c.terms() }}{{ c.references() }}</div></section>
  {{ c.line_table('Material / service', 'Docket category', 'Lot quantity', 'Lot / approval ref') }}
  <div style="margin-top:11px">{{ c.totals('Docket total') }}</div>{{ c.footer() }}
</article>{% endblock %}
