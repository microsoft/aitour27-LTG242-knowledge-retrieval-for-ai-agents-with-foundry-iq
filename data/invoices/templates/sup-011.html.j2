{% extends "_base.html.j2" %}
{% import "_components.html.j2" as c with context %}
{% block supplier_css %}
  .release-packet { border:3px double var(--primary); margin:.16in; min-height:10.68in; padding:.3in; }
  .release-packet header { text-align:center; }
  .release-packet .brand { justify-content:center; }
  .release-packet .heading { border-bottom:1px solid var(--primary); border-top:1px solid var(--primary); display:flex; justify-content:space-between; margin-top:12px; padding:8px 0; text-align:left; }
  .release-packet .invoice-label { font-size:16px; }
  .release-packet .hero-total { border:0; margin:0; padding:0; text-align:right; }
  .packet-title { font-size:9px; letter-spacing:.18em; margin-top:6px; text-align:center; text-transform:uppercase; }
  .packet-grid { display:grid; gap:14px; grid-template-columns:.8fr 1.2fr; margin-top:12px; }
  .release-packet table { margin-top:14px; }
  .release-packet th { background:#fff; border-bottom:2px solid var(--primary); border-top:2px solid var(--primary); color:var(--primary); }
{% endblock %}
{% block document %}<article class="invoice release-packet">
  <header>{{ c.brand() }}<div class="packet-title">Sterilization services · formal release packet</div>{{ c.heading() }}</header>
  <div style="margin-top:12px">{{ c.metadata() }}</div><section class="packet-grid"><div class="stack">{{ c.terms() }}{{ c.references() }}</div>{{ c.parties() }}</section>
  {{ c.line_table('Release packet item', 'Cycle / test class', 'Cycles / lots', 'Cycle or release ref') }}
  <div style="margin-top:11px">{{ c.totals('Packet amount due') }}</div>{{ c.footer() }}
</article>{% endblock %}
