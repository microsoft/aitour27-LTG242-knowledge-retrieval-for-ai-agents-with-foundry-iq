{% macro brand() -%}
<div class="brand">
  <img class="supplier-logo" src="{{ supplier_logo_uri }}" alt="{{ invoice.supplier_name }}">
</div>
{%- endmacro %}

{% macro heading() -%}
<div class="heading">
  <div class="invoice-label">Invoice</div>
  <div class="invoice-id">{{ invoice.invoice_id }}</div>
  <div class="hero-total"><span class="eyebrow">Total due</span><span class="amount">{{ invoice.total_amount | money }}</span></div>
</div>
{%- endmacro %}

{% macro metadata() -%}
<section class="meta">
  <div><span class="eyebrow">Invoice date</span><strong>{{ invoice.invoice_date }}</strong></div>
  <div><span class="eyebrow">Due date</span><strong>{{ invoice.due_date }}</strong></div>
  <div><span class="eyebrow">Purchase order</span><strong>{{ invoice.purchase_order_id }}</strong></div>
  <div><span class="eyebrow">Service period</span><strong>{{ invoice.service_period }}</strong></div>
</section>
{%- endmacro %}

{% macro parties() -%}
<section class="parties">
  <div class="party">
    <div class="party-heading"><span class="eyebrow">Bill to</span><img class="customer-logo" src="{{ logo_uri }}" alt="Caldova"></div>
    <div class="party-name">Caldova Accounts Payable</div>
    <div class="party-line">1000 Discovery Parkway</div><div class="party-line">Cambridge, MA 02139</div>
    <div class="party-line">Account {{ invoice.customer_account }}</div><div class="party-line">ap@caldova.example</div>
  </div>
  <div class="party">
    <div class="party-heading"><span class="eyebrow">Remit to</span></div>
    <div class="party-name">{{ invoice.supplier_name }}</div>
    {% for address_line in invoice.supplier_address %}<div class="party-line">{{ address_line }}</div>{% endfor %}
    <div class="party-line">{{ invoice.supplier_email }}</div>
  </div>
</section>
{%- endmacro %}

{% macro references() -%}
<div class="references"><span class="eyebrow">Supporting documents</span><ul>{% for item in invoice.support_references %}<li>{{ item }}</li>{% endfor %}</ul></div>
{%- endmacro %}

{% macro terms() -%}
<div class="terms">
  <span>Terms</span><span>{{ invoice.payment_terms }}</span><span>Currency</span><span>{{ invoice.currency }}</span>
  <span>Tax</span><span>{{ invoice.tax_display }}</span><span>Remittance reference</span><span>{{ invoice.remittance_reference }}</span>
</div>
{%- endmacro %}

{% macro line_table(first_label='Line item', type_label='Type', quantity_label='Quantity', reference_label='Reference') -%}
<table aria-label="Invoice line items">
  <thead><tr><th style="width:48%">{{ first_label }}</th><th style="width:17%">{{ type_label }}</th><th class="number" style="width:11%">{{ quantity_label }}</th><th class="number" style="width:12%">Unit price</th><th class="number" style="width:12%">Amount</th></tr></thead>
  <tbody>{% for line in invoice.lines %}<tr>
    <td><div class="line-id">{{ line.display_line_id }}</div><div class="description">{{ line.description }}</div><div class="reference">{{ reference_label }}: {{ line.reference_id }}</div></td>
    <td>{{ line.line_type }}</td><td class="number">{{ line.quantity | quantity }}</td><td class="number">{{ line.unit_price | unit_price }}</td><td class="number">{{ line.amount | money }}</td>
  </tr>{% endfor %}</tbody>
</table>
{%- endmacro %}

{% macro totals(label='Total due') -%}
<section class="totals"><div class="totals-box">
  <div class="totals-row"><span>Subtotal</span><span>{{ invoice.total_amount | money }}</span></div>
  <div class="totals-row"><span>Tax</span><span>{{ invoice.tax_display }}</span></div>
  <div class="totals-row final"><span>{{ label }}</span><span>{{ invoice.total_amount | money }}</span></div>
</div></section>
{%- endmacro %}

{% macro footer() -%}
<footer><span>{{ invoice.supplier_name }} | {{ invoice.supplier_email }}</span><span>{{ invoice.invoice_id }} | Page 1 of 1</span></footer>
{%- endmacro %}
