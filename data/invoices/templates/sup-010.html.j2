{% extends "_base.html.j2" %}
{% import "_components.html.j2" as c with context %}
{% block supplier_css %}
  .device { border:1px solid #6f7882; margin:.2in; min-height:10.6in; padding:.28in; }
  .device-head { align-items:center; background:#303b47; color:#fff; display:flex; justify-content:space-between; margin:-.28in -.28in 0; padding:.24in .28in; }
  .device-head .supplier-name,.device-head .subtitle { color:#fff; }
  .build-id { border:2px solid #303b47; display:grid; gap:0; grid-template-columns:repeat(4,1fr); margin-top:13px; }
  .build-id > div { padding:8px; }
  .build-id > div + div { border-left:1px solid #6f7882; }
  .device table { margin-top:14px; }
  .device th { background:#303b47; }
  .device-close { display:grid; gap:14px; grid-template-columns:1fr 1fr; margin-top:12px; }
{% endblock %}
{% block document %}<article class="invoice device">
  <header class="device-head">{{ c.brand() }}<div style="text-align:right"><div class="eyebrow" style="color:#cfd6dc">Device build invoice</div><strong>{{ invoice.invoice_id }}</strong></div></header>
  <section class="build-id">{{ c.metadata() }}</section><div style="margin-top:12px">{{ c.parties() }}</div>
  {{ c.line_table('Build lot / activity', 'Build operation', 'Accepted qty', 'Traveler / ECO ref') }}
  <section class="device-close"><div class="stack">{{ c.references() }}{{ c.terms() }}</div>{{ c.totals('Build balance') }}</section>{{ c.footer() }}
</article>{% endblock %}
