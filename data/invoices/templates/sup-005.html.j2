{% extends "_base.html.j2" %}
{% import "_components.html.j2" as c with context %}
{% block supplier_css %}
  .lab { border-top:8px solid var(--accent); }
  .lab header { align-items:center; display:flex; justify-content:space-between; padding:8px 0 14px; }
  .lab-banner { background:var(--tint); border-bottom:1px solid var(--accent); border-top:1px solid var(--accent); color:var(--primary); font-family:Georgia,serif; font-size:16px; padding:9px; text-align:center; }
  .lab .meta { margin-top:10px; }
  .lab table { margin-top:14px; }
  .lab tbody tr:nth-child(even) { background:#fffaf0; }
  .lab-close { align-items:start; display:grid; gap:14px; grid-template-columns:1.3fr .7fr; margin-top:12px; }
{% endblock %}
{% block document %}<article class="invoice lab">
  <header>{{ c.brand() }}{{ c.heading() }}</header><div class="lab-banner">GMP laboratory services &amp; milestone statement</div>
  {{ c.metadata() }}<div style="margin-top:12px">{{ c.parties() }}</div>
  {{ c.line_table('Test / deliverable', 'Laboratory stage', 'Milestones', 'Protocol / CoA ref') }}
  <section class="lab-close"><div class="stack">{{ c.references() }}{{ c.terms() }}</div>{{ c.totals('Laboratory balance') }}</section>{{ c.footer() }}
</article>{% endblock %}
