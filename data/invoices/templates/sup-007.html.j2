{% extends "_base.html.j2" %}
{% import "_components.html.j2" as c with context %}
{% block supplier_css %}
  .protocol header { border-bottom:1px solid var(--primary); display:grid; gap:18px; grid-template-columns:2fr 1fr; padding-bottom:12px; }
  .protocol-title { background:var(--primary); color:#fff; font-family:Georgia,serif; font-size:16px; margin-top:12px; padding:9px 12px; }
  .protocol-grid { display:grid; gap:14px; grid-template-columns:1fr 1.4fr; margin-top:12px; }
  .protocol .meta { grid-template-columns:1fr 1fr; }
  .protocol .meta > div:nth-child(2) { border-right:0; }
  .protocol table { margin-top:14px; }
  .protocol th { background:#fff; border-bottom:2px solid var(--primary); color:var(--primary); }
{% endblock %}
{% block document %}<article class="invoice protocol">
  <header>{{ c.brand() }}{{ c.heading() }}</header><div class="protocol-title">Clinical study supply ledger</div>
  <section class="protocol-grid"><div class="stack">{{ c.metadata() }}{{ c.references() }}</div><div class="stack">{{ c.parties() }}{{ c.terms() }}</div></section>
  {{ c.line_table('Protocol activity', 'Study category', 'Study qty', 'Protocol evidence') }}
  <div style="margin-top:11px">{{ c.totals('Current study charges') }}</div>{{ c.footer() }}
</article>{% endblock %}
