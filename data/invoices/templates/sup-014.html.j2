{% extends "_base.html.j2" %}
{% import "_components.html.j2" as c with context %}
{% block supplier_css %}
  .trueup header { align-items:end; border-bottom:6px solid var(--accent); display:flex; justify-content:space-between; padding-bottom:10px; }
  .trueup-title { display:grid; gap:0; grid-template-columns:1.2fr .8fr; margin-top:12px; }
  .trueup-title > div { padding:12px; }
  .trueup-title > div:first-child { background:var(--primary); color:#fff; font-size:17px; font-weight:800; }
  .trueup-title > div:last-child { background:var(--tint); text-align:right; }
  .trueup-grid { display:grid; gap:14px; grid-template-columns:.7fr 1.3fr; margin-top:12px; }
  .trueup table { margin-top:14px; }
  .trueup tbody tr:last-child { background:var(--tint); font-weight:700; }
{% endblock %}
{% block document %}<article class="invoice trueup">
  <header>{{ c.brand() }}{{ c.heading() }}</header>
  <section class="trueup-title"><div>Regional manufacturing true-up</div><div><span class="eyebrow">Statement period</span><br>{{ invoice.service_period }}</div></section>
  <div class="trueup-grid"><div class="stack">{{ c.terms() }}{{ c.references() }}</div><div class="stack">{{ c.metadata() }}{{ c.parties() }}</div></div>
  {{ c.line_table('Production / true-up entry', 'Regional class', 'Actual qty', 'Forecast / actual ref') }}
  <div style="margin-top:10px">{{ c.totals('True-up balance') }}</div>{{ c.footer() }}
</article>{% endblock %}
