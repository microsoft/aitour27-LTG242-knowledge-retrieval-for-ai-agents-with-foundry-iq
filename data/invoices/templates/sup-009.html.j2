{% extends "_base.html.j2" %}
{% import "_components.html.j2" as c with context %}
{% block supplier_css %}
  .capacity header { align-items:start; display:grid; gap:18px; grid-template-columns:1fr 2.4in; }
  .statement-title { color:var(--primary); font-family:Georgia,serif; font-size:22px; margin-top:14px; }
  .statement-band { align-items:center; background:var(--primary); color:#fff; display:grid; gap:20px; grid-template-columns:1fr 1fr; margin-top:8px; padding:12px 14px; }
  .statement-band .eyebrow { color:#eadde5; }
  .statement-band .amount { font-size:20px; font-weight:800; text-align:right; }
  .capacity-grid { display:grid; gap:14px; grid-template-columns:1.2fr .8fr; margin-top:12px; }
  .capacity table { margin-top:14px; }
  .capacity tbody tr { background:#fff; }
  .capacity tbody tr + tr { border-top:2px solid var(--tint); }
{% endblock %}
{% block document %}<article class="invoice capacity">
  <header>{{ c.brand() }}<div>{{ c.terms() }}</div></header><div class="statement-title">Quarterly capacity statement</div>
  <section class="statement-band"><div><div class="eyebrow">Statement number</div><strong>{{ invoice.invoice_id }}</strong></div><div class="amount">{{ invoice.total_amount | money }}</div></section>
  <div style="margin-top:12px">{{ c.metadata() }}</div><section class="capacity-grid">{{ c.parties() }}{{ c.references() }}</section>
  {{ c.line_table('Capacity entry', 'Capacity class', 'Hours / runs', 'Run or deviation log') }}
  <div style="margin-top:10px">{{ c.totals('Quarterly balance') }}</div>{{ c.footer() }}
</article>{% endblock %}
